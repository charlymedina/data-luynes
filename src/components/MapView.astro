---
import InfoTip from './InfoTip.astro';
import type { Methode } from '../data/methodes';
/**
 * Carte interactive de Luynes : contour de la commune, zones colorées (ex. zone inondable) et couches de points,
 * avec légende (cases à cocher pour afficher / masquer chaque couche). La carte elle-même est dessinée
 * dans le navigateur par src/lib/map.ts, chargé seulement sur les pages qui ont une carte.
 * Le slot reçoit l'alternative accessible (liste ou tableau des mêmes informations).
 */
import type { MapAreaData, MapData, MapLayerData } from '../lib/map';
import type { Geometry } from '../lib/map-base';

export interface MapLegendItem {
  layer: MapLayerData;
  label: string;
}

export interface MapAreaLegendItem {
  area: MapAreaData;
  label: string;
}

interface Props {
  /** Bulle ⓘ « Source · Calcul · Année » de la carte (src/data/methodes.ts). */
  info?: Methode;
  ariaLabel: string;
  contour: Geometry;
  legend: readonly MapLegendItem[];
  areas?: readonly MapAreaLegendItem[];
}

const { ariaLabel, contour, legend, areas = [], info } = Astro.props;
const data: MapData = { contour, areas: areas.map((item) => item.area), layers: legend.map((item) => item.layer) };
const json = JSON.stringify(data).replaceAll('<', '\\u003c');
const entries = [
  ...areas.map((item) => ({ id: item.area.id, colorVar: item.area.colorVar, label: item.label, shape: 'rounded-[3px] opacity-60', checked: !item.area.masquee })),
  ...legend.map((item) => ({ id: item.layer.id, colorVar: item.layer.colorVar, label: item.label, shape: 'rounded-full', checked: true })),
];
---

<figure data-map="couches" class="map-root overflow-hidden rounded-[1.5rem] border border-line bg-surface" data-indicateur={info ? 'ok' : 'sans-bulle'}>
  <div class="flex flex-wrap gap-x-5 gap-y-2 border-b border-line px-4 py-3 text-sm sm:px-6">
    {
      entries.map((entry) => (
        <label class="flex cursor-pointer items-center gap-2 select-none">
          <input type="checkbox" checked={entry.checked} data-layer={entry.id} class="peer sr-only" />
          <span
            class:list={[
              'inline-block size-3.5 ring-2 ring-surface transition peer-checked:opacity-100 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-loire opacity-30',
              entry.shape,
            ]}
            style={`background:var(${entry.colorVar})`}
            aria-hidden="true"
          />
          <span class="text-ink-2 peer-checked:text-ink">{entry.label}</span>
        </label>
      ))
    }
    <span class="flex items-center gap-2 text-ink-2">
      <span class="inline-block h-0 w-5 border-t-2 border-dashed border-loire" aria-hidden="true"></span>
      Limite de la commune
    </span>
    {info && <span class="ml-auto"><InfoTip methode={info} label={info.titre} /></span>}
  </div>
  <div class="map-canvas relative h-[22rem] w-full sm:h-[30rem]" role="region" aria-label={ariaLabel}>
    <p class="map-fallback absolute inset-0 grid place-items-center p-6 text-center text-sm text-muted">
      Chargement de la carte…
    </p>
  </div>
  <script is:inline type="application/json" class="map-data" set:html={json} />
  <figcaption class="border-t border-line px-4 py-3 text-xs text-muted sm:px-6">
    Cliquer sur un point ou une zone pour le détail. Fond de carte © OpenFreeMap, données © contributeurs OpenStreetMap.
  </figcaption>
  <div class="border-t border-line px-4 py-3 sm:px-6">
    <slot />
  </div>
</figure>

<script>
  import { initMaps } from '../lib/map';
  initMaps();
</script>

<style>
  .map-root[data-ready='true'] .map-fallback {
    display: none;
  }
  .map-root[data-ready='error'] .map-fallback {
    color: var(--ink-2);
  }
</style>
