---
import { generatedAt, sourcesEnRetard } from '../data/commune';
import { lienSignalement } from '../lib/signalement';

export interface FooterSource {
  nom: string;
  url: string;
  /** Producteur et licence, ex. « INSEE — Licence Ouverte 2.0 » */
  detail: string;
}

interface Props {
  sources: readonly FooterSource[];
}

const { sources } = Astro.props;
const dateMaj = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(generatedAt);
const dateCourte = (iso: string): string => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'short' }).format(new Date(iso));
const lienFormulaire = lienSignalement(Astro.url.pathname);
const linkClass = 'underline decoration-accent underline-offset-4 hover:text-ink';
---

<footer class="mx-auto mt-24 max-w-6xl border-t border-line px-4 py-10 text-sm text-ink-2 sm:px-6">
  {
    sources.length > 0 && (
      <>
        <p class="font-semibold text-ink">Sources</p>
        <ul class="mt-2 mb-4 space-y-1">
          {sources.map((source) => (
            <li>
              <a class={linkClass} href={source.url}>{source.nom}</a> — {source.detail}
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    sourcesEnRetard.length > 0 && (
      <p class="mb-4 rounded-xl border border-dashed border-accent p-3">
        ⚠️ Lors de la dernière mise à jour, {sourcesEnRetard.length > 1 ? 'certaines sources n’ont' : 'une source n’a'} pas répondu :
        leurs données précédentes sont affichées.{' '}
        {sourcesEnRetard.map((s) => `${s.description} (données du ${dateCourte(s.depuis)})`).join(' ; ')}.
      </p>
    )
  }
  <p>
    Site reconstruit le {dateMaj} à partir des dernières données publiées (l'année de chaque chiffre est indiquée sous le symbole ⓘ).
    Site indépendant, non officiel, fait avec ❤️ à Luynes.
  </p>
  <p class="mt-2">
    <a class={linkClass} href="/a-propos">À propos et mentions légales</a>
  </p>
  <p class="mt-2">
    <a class={linkClass} href={lienFormulaire}>Signaler une erreur ou proposer une idée</a>
  </p>
</footer>
