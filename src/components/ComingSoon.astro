---
/** Les thèmes pas encore ouverts : visibles mais non cliquables (style « pointillés »). */
import type { Theme } from '../data/themes';

interface Props {
  themes: readonly Theme[];
}

const { themes } = Astro.props;
---

<section aria-labelledby="bientot" class="reveal mt-20 sm:mt-28">
  <h2 id="bientot" class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Bientôt sur le site</h2>
  <p class="mt-3 max-w-xl text-ink-2">Les prochains thèmes en préparation, à partir des données publiques disponibles pour Luynes.</p>
  <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {
      themes.map((theme, i) => (
        <li
          class="rounded-[1.25rem] border border-dashed border-line p-4 transition hover:-translate-y-1 hover:border-loire hover:bg-loire-soft sm:p-6"
          style={`rotate: ${i % 2 === 0 ? -0.6 : 0.6}deg`}
        >
          <span class="text-2xl sm:text-3xl" aria-hidden="true">{theme.emoji}</span>
          <h3 class="mt-2 font-display text-lg leading-tight font-bold sm:mt-3 sm:text-xl">{theme.titre}</h3>
          <p class="mt-1 text-xs text-ink-2 sm:text-sm">{theme.resume}</p>
          <p class="mt-3 text-xs font-semibold tracking-wide text-muted uppercase">Bientôt</p>
        </li>
      ))
    }
  </ul>
</section>
