---
/**
 * Jauge de classement : une réglette de 1 à N (toutes les communes du département),
 * avec la position de Luynes marquée. Remplace une liste de rangs écrite en toutes lettres.
 */
import Icon, { type IconName } from '../Icon.astro';
import { formatRank } from '../../lib/format';

interface Props {
  label: string;
  rank: number;
  total: number;
  icon: IconName;
  /** Libellés des deux bouts de la réglette, ex. ["le plus élevé", "le plus faible"] */
  ends?: readonly [string, string];
}

const { label, rank, total, icon, ends = ['le plus élevé', 'le plus faible'] } = Astro.props;
const position = total > 1 ? ((rank - 1) / (total - 1)) * 100 : 0;
---

<figure class="rounded-[1.25rem] border border-line bg-surface p-5">
  <figcaption class="flex items-center gap-2.5 text-sm font-semibold text-ink">
    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name={icon} class="h-5 w-5" /></span>
    {label}
  </figcaption>
  <p class="mt-4 font-display text-3xl font-extrabold tracking-tight">
    {formatRank(rank)} <span class="text-base font-semibold text-ink-2">sur {total}</span>
  </p>
  <div class="relative mt-4 h-3 rounded-full bg-chart-grid" role="img" aria-label={`${label} : Luynes ${formatRank(rank)} sur ${total} communes`}>
    <span
      class="absolute top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-surface bg-accent shadow"
      style={`left:${position}%`}
    ></span>
  </div>
  <p class="mt-2 flex justify-between text-xs text-muted"><span>1ʳᵉ · {ends[0]}</span><span>{ends[1]}</span></p>
</figure>
