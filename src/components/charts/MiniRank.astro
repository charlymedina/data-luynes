---
import InfoTip from '../InfoTip.astro';
import type { Methode } from '../../data/methodes';
/**
 * Réglette de classement compacte, à glisser dans une carte de chiffre clé :
 * une ligne de 1 à N (toutes les communes du département) et un point pour Luynes.
 * Version courte de RankGauge, qui remplace une phrase du type « 19ᵉ commune sur 272 ».
 * Le rang est toujours accompagné de son ensemble (« sur 272 communes d'Indre-et-Loire »).
 */
import { COMMUNES_37, formatCommunes, formatRank } from '../../lib/format';

interface Props {
  /** Bulle ⓘ, quand ces mini-barres ne sont pas déjà dans un chiffre clé qui a la sienne. */
  info?: Methode;
  rank: number;
  total: number;
  /** Ce qui est classé, ex. « la plus peuplée » (lu par les lecteurs d'écran et affiché en petit) */
  what: string;
  /** Ensemble de référence, par défaut « communes d'Indre-et-Loire ». */
  ensemble?: string;
  /** Sur fond sarcelle (carte « loire »), la réglette passe en clair. */
  onDark?: boolean;
}

const { rank, total, what, ensemble = COMMUNES_37, onDark = false, info } = Astro.props;
const position = total > 1 ? ((rank - 1) / (total - 1)) * 100 : 0;
const surQui = `sur ${formatCommunes(total, ensemble)}`;
---

{info && <div class="-mb-3 mt-3 flex justify-end"><InfoTip methode={info} label={info.titre} onDark={onDark} /></div>}
<figure class="mt-5 text-xs">
  <div
    class:list={['relative h-2 rounded-full', onDark ? 'bg-bg/25' : 'bg-chart-grid']}
    role="img"
    aria-label={`Luynes ${formatRank(rank)} ${what}, ${surQui}`}
  >
    <span
      class:list={[
        'absolute top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] shadow-sm',
        onDark ? 'border-loire bg-bg' : 'border-surface bg-accent',
      ]}
      style={`left:${position}%`}
    ></span>
  </div>
  <figcaption class="mt-2 leading-snug opacity-85">
    <strong class="font-semibold">{formatRank(rank)}</strong> {what} {surQui}
  </figcaption>
</figure>
