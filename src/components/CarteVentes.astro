---
import InfoTip from './InfoTip.astro';
import type { Methode } from '../data/methodes';
/**
 * Carte de toutes les ventes immobilières de Luynes, avec filtres (type de bien, année), légende des prix
 * au m² et tableau des ventes (alternative accessible, filtré en même temps que la carte).
 * La carte est dessinée par src/lib/map-ventes.ts ; les ventes sont lues dans /donnees/ventes-immobilieres.json.
 */
import type { Geometry } from '../lib/map-base';
import { TYPES_BIEN, type Vente } from '../data/immobilier';
import { formatNumber } from '../lib/format';

interface Props {
  /** Bulle ⓘ « Source · Calcul · Année » de la carte (src/data/methodes.ts). */
  info?: Methode;
  ventes: readonly Vente[];
  contour: Geometry;
  seuils: readonly number[];
}

const { ventes, contour, seuils, info } = Astro.props;
const anneesDispo = [...new Set(ventes.map((v) => v.annee))].sort((a, b) => b - a);
const config = JSON.stringify({ contour, seuils }).replaceAll('<', '\\u003c');
const PLURIELS: Record<string, string> = { Maison: 'Maisons', Appartement: 'Appartements', Terrain: 'Terrains', Autre: 'Autres' };

const legendePrix = [
  `moins de ${formatNumber(seuils[0] ?? 0)} €`,
  ...seuils.slice(0, -1).map((s, i) => `${formatNumber(s)} – ${formatNumber(seuils[i + 1] ?? s)} €`),
  `${formatNumber(seuils.at(-1) ?? 0)} € et plus`,
];
const dateCourte = new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
const pastille =
  'cursor-pointer rounded-full border border-line px-3 py-1.5 text-sm transition select-none hover:border-loire peer-checked:border-loire peer-checked:bg-loire peer-checked:text-bg peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-loire';
---

<figure data-map="ventes" data-ventes-url="/donnees/ventes-immobilieres.json" class="map-root overflow-hidden rounded-[1.5rem] border border-line bg-surface" data-indicateur={info ? 'ok' : 'sans-bulle'}>
  <form class="space-y-3 border-b border-line px-4 py-4 sm:px-6" aria-label="Filtrer les ventes">
    <fieldset class="flex flex-wrap items-center gap-2">
      <legend class="sr-only">Type de bien</legend>
      <span class="mr-1 text-xs font-semibold tracking-wide text-ink-2 uppercase" aria-hidden="true">Bien</span>
      {
        ['tous', ...TYPES_BIEN].map((type) => (
          <label>
            <input type="radio" name="filtre-type" value={type} checked={type === 'tous'} class="peer sr-only" />
            <span class={pastille}>{type === 'tous' ? 'Tous' : PLURIELS[type]}</span>
          </label>
        ))
      }
    </fieldset>
    <fieldset class="flex flex-wrap items-center gap-2">
      <legend class="sr-only">Année</legend>
      <span class="mr-1 text-xs font-semibold tracking-wide text-ink-2 uppercase" aria-hidden="true">Année</span>
      {
        ['tous', ...anneesDispo.map(String)].map((annee) => (
          <label>
            <input type="radio" name="filtre-annee" value={annee} checked={annee === 'tous'} class="peer sr-only" />
            <span class={pastille}>{annee === 'tous' ? 'Toutes' : annee}</span>
          </label>
        ))
      }
    </fieldset>
    <p class="text-sm text-ink-2" aria-live="polite"><strong class="ventes-compte text-ink">{formatNumber(ventes.length)} ventes</strong> affichées</p>
  </form>

  <div class="map-canvas relative h-[24rem] w-full sm:h-[34rem]" role="region" aria-label={`Carte des ${formatNumber(ventes.length)} ventes immobilières de Luynes`}>
    <p class="map-fallback absolute inset-0 grid place-items-center p-6 text-center text-sm text-muted">Chargement de la carte…</p>
  </div>
  <script is:inline type="application/json" class="map-data" set:html={config} />

  <div class="border-t border-line px-4 py-3 sm:px-6">
    <p class="text-xs font-semibold tracking-wide text-ink-2 uppercase">Prix au m² (maison ou appartement seul)</p>
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-ink-2">
      {
        legendePrix.map((libelle, i) => (
          <li class="flex items-center gap-1.5">
            <span class="inline-block size-3 rounded-full" style={`background:var(--seq-${i + 1})`} aria-hidden="true" />
            {libelle}
          </li>
        ))
      }
      <li class="flex items-center gap-1.5">
        <span class="inline-block size-2.5 rounded-full" style="background:var(--seq-none)" aria-hidden="true"></span>
        terrain, vente multiple… (pas de prix au m²)
      </li>
      <li class="flex items-center gap-1.5">
        <span class="inline-grid size-4 place-items-center rounded-full bg-ink text-[0.55rem] font-bold text-bg" aria-hidden="true">9</span>
        plusieurs ventes : cliquer pour zoomer
      </li>
      {info && <li class="ml-auto"><InfoTip methode={info} label={info.titre} /></li>}
    </ul>
  </div>
  <figcaption class="border-t border-line px-4 py-3 text-xs text-muted sm:px-6">
    Cliquer sur un point pour la fiche de la vente. Position : centre de la parcelle vendue ; adresse limitée à la rue.
    Fond de carte © OpenFreeMap, données © contributeurs OpenStreetMap.
  </figcaption>

  <details class="border-t border-line px-4 py-3 text-sm text-ink-2 sm:px-6">
    <summary class="cursor-pointer font-medium hover:text-ink">Voir les ventes en tableau (<span class="ventes-compte">{formatNumber(ventes.length)} ventes</span>)</summary>
    <div class="mt-3 max-h-96 overflow-auto rounded-xl border border-line">
      <table class="tabular w-full text-left text-xs sm:text-sm">
        <caption class="sr-only">Ventes immobilières de Luynes, de la plus récente à la plus ancienne</caption>
        <thead class="sticky top-0 bg-surface">
          <tr>
            <th scope="col" class="px-2 py-2 sm:px-3">Date</th>
            <th scope="col" class="px-2 py-2 sm:px-3">Bien</th>
            <th scope="col" class="px-2 py-2 text-right sm:px-3">Prix</th>
            <th scope="col" class="hidden px-3 py-2 text-right sm:table-cell">Surface</th>
            <th scope="col" class="px-2 py-2 text-right sm:px-3">€/m²</th>
            <th scope="col" class="hidden px-3 py-2 md:table-cell">Rue</th>
          </tr>
        </thead>
        <tbody class="ventes-lignes">
          {
            ventes.map((v) => (
              <tr data-type={v.type} data-annee={v.annee}>
                <td>{dateCourte.format(new Date(v.date))}</td>
                <td>{v.type}</td>
                <td class="num">{formatNumber(v.prix)} €</td>
                <td class="num sm-plus">{v.surface_bati ? `${formatNumber(v.surface_bati)} m²` : '—'}</td>
                <td class="num">{v.prix_m2 ? formatNumber(v.prix_m2) : '—'}</td>
                <td class="md-plus">{v.rue}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<script>
  import { initCarteVentes } from '../lib/map-ventes';
  initCarteVentes();
</script>

<style>
  .map-root[data-ready='true'] .map-fallback {
    display: none;
  }
  .map-root[data-ready='error'] .map-fallback {
    color: var(--ink-2);
  }
  /* Styles des ~400 lignes du tableau écrits une seule fois ici (et non sur chaque cellule) : page plus légère. */
  .ventes-lignes tr {
    border-top: 1px solid var(--line);
  }
  .ventes-lignes td {
    padding: 0.375rem 0.5rem;
    white-space: nowrap;
  }
  .ventes-lignes td.num {
    text-align: right;
  }
  .ventes-lignes td.sm-plus,
  .ventes-lignes td.md-plus {
    display: none;
  }
  @media (min-width: 40rem) {
    .ventes-lignes td {
      padding-inline: 0.75rem;
    }
    .ventes-lignes td.sm-plus {
      display: table-cell;
    }
  }
  @media (min-width: 48rem) {
    .ventes-lignes td.md-plus {
      display: table-cell;
    }
  }
</style>
