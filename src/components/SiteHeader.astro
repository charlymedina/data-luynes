---
/**
 * Barre de navigation fixe (reste visible en défilant) : logo, menu des thèmes, bouton clair/sombre.
 * Grand écran : liens visibles (s'il y en a peu) ; sinon et sur mobile : bouton « menu » qui ouvre un panneau.
 * Comportement du panneau (ouverture, Échap, clic extérieur, focus) : lib/nav.ts.
 */
import LogoAqueduc from './LogoAqueduc.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { themesDisponibles } from '../data/themes';

/** Au-delà de ce nombre de thèmes, les liens ne tiennent plus sur une ligne : menu seul. */
const MAX_INLINE_LINKS = 7;
const inline = themesDisponibles.length <= MAX_INLINE_LINKS;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (slug: string): boolean => current === `/${slug}`;
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 rounded-xl font-display text-lg font-bold tracking-tight focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none"
      aria-current={current === '/' ? 'page' : undefined}
    >
      <LogoAqueduc class="h-9 w-9 transition-transform duration-300 group-hover:-rotate-6" />
      <span>Luynes <span class="text-accent">en chiffres</span></span>
    </a>

    {
      inline && (
        <nav aria-label="Thèmes" class="hidden lg:block">
          <ul class="flex items-center gap-1">
            {themesDisponibles.map((theme) => (
              <li>
                <a
                  href={`/${theme.slug}`}
                  aria-current={isCurrent(theme.slug) ? 'page' : undefined}
                  class="nav-link rounded-full px-3 py-2 text-sm font-medium text-ink-2 transition hover:bg-surface hover:text-ink focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none"
                >
                  {theme.court}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="flex shrink-0 items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="menu-themes"
        class:list={[
          'nav-toggle grid h-10 w-10 place-items-center rounded-full border border-line bg-surface text-ink transition hover:border-accent hover:text-accent focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none active:scale-90',
          inline && 'lg:hidden',
        ]}
      >
        <span class="sr-only" data-nav-label>Ouvrir le menu</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bar bar-1" d="M4 7h16" />
          <path class="bar bar-2" d="M4 12h16" />
          <path class="bar bar-3" d="M4 17h16" />
        </svg>
      </button>
    </div>

    <div id="menu-themes" data-nav-panel hidden class="nav-panel absolute inset-x-0 top-full px-4 pt-2 sm:px-6">
      <nav aria-label="Menu des thèmes" class="ml-auto max-w-md rounded-[1.5rem] border border-line bg-surface p-3 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.45)]">
        <ul class="grid grid-cols-[minmax(0,1fr)] gap-1">
          <li>
            <a
              href="/"
              aria-current={current === '/' ? 'page' : undefined}
              class="nav-item flex items-center gap-3 rounded-2xl px-3 py-2.5 font-medium transition hover:bg-loire-soft focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none"
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><LogoAqueduc class="h-6 w-6" /></span>
              Accueil
            </a>
          </li>
          {
            themesDisponibles.map((theme) => (
              <li>
                <a
                  href={`/${theme.slug}`}
                  aria-current={isCurrent(theme.slug) ? 'page' : undefined}
                  class="nav-item flex items-center gap-3 rounded-2xl px-3 py-2.5 transition hover:bg-loire-soft focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none"
                >
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-loire-soft text-loire">
                    <Icon name={theme.icon} class="h-5 w-5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-medium text-ink">{theme.titre}</span>
                    <span class="block truncate text-xs text-ink-2">{theme.resume}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Fond légèrement translucide et flou ; ombre discrète dès qu'on a défilé (data-scrolled posé par lib/nav.ts). */
  .site-header {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -22px rgb(0 0 0 / 0.45);
  }
  .nav-link[aria-current='page'] {
    background: var(--loire-soft);
    color: var(--loire);
    font-weight: 600;
  }
  .nav-item[aria-current='page'] {
    background: var(--loire-soft);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  /* Burger → croix quand le menu est ouvert */
  .bar {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .bar-1 {
    transform: translateY(5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .bar-2 {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .bar-3 {
    transform: translateY(-5px) rotate(-45deg);
  }

  .nav-panel:not([hidden]) {
    animation: panel-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar,
    .site-header {
      transition: none;
    }
    .nav-panel:not([hidden]) {
      animation: none;
    }
  }
</style>
