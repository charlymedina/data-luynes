---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<header class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 pt-6 sm:px-6">
  <div class="flex items-center gap-4">
    <a href="/" class="group flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <img src="/favicon.svg" alt="" width="28" height="28" class="transition-transform group-hover:rotate-12" />
      luynes<span class="text-accent">·</span>data
    </a>
    {
      showBack && (
        <a
          href="/"
          class="rounded-full px-2 py-1 text-sm font-medium whitespace-nowrap text-ink-2 transition sm:px-3 hover:bg-surface hover:text-ink focus-visible:ring-2 focus-visible:ring-loire focus-visible:outline-none"
        >
          ← Accueil
        </a>
      )
    }
  </div>
  <div class="flex items-center gap-3">
    <span class="hidden rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-2 sm:inline">v0 · en construction</span>
    <button
      type="button"
      data-theme-toggle
      aria-label="Changer de thème"
      aria-pressed="false"
      class="theme-toggle grid h-10 w-10 place-items-center rounded-full border border-line bg-surface text-ink transition hover:-rotate-12 hover:border-accent hover:text-accent focus-visible:ring-4 focus-visible:ring-loire/40 focus-visible:outline-none active:scale-90"
    >
      <!-- Lune (affichée en thème clair) -->
      <svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <!-- Soleil (affiché en thème sombre) -->
      <svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<style>
  /* Une seule icône visible selon le thème effectif ; les deux sont superposées dans la même case. */
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global(:root[data-theme='dark']) .icon-sun {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      opacity: 1;
      transform: none;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle svg {
      transition: none;
    }
  }
</style>
