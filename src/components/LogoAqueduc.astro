---
/**
 * Marque du site : trois arches de l'aqueduc gallo-romain de Luynes au-dessus d'une vague de Loire.
 * Même dessin que public/favicon.svg, mais aux couleurs du thème courant (clair ou sombre).
 */
interface Props {
  class?: string;
}

const { class: className = 'h-8 w-8' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--loire)"></rect>
  <path
    fill="var(--bg)"
    fill-rule="evenodd"
    d="M4.5 8.5h23v14.5h-23Z M7 23v-8a2.25 2.25 0 0 1 4.5 0v8Z M13.75 23v-8a2.25 2.25 0 0 1 4.5 0v8Z M20.5 23v-8a2.25 2.25 0 0 1 4.5 0v8Z M23.5 8.5h4v3l-1.6-1.2-1.2 1-1.2-1.4Z"
  ></path>
  <path d="M4 27c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0 4 1.5 6 0" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round"></path>
</svg>
