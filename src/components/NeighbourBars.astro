---
import type { Voisine } from '../data/commune';
import { formatNumber } from '../lib/format';

interface Props {
  voisines: readonly Voisine[];
}

const { voisines } = Astro.props;
const max = Math.max(...voisines.map((v) => v.population));
---

<figure>
  <ol class="space-y-2.5" aria-label="Population de Luynes et de ses communes voisines">
    {
      voisines.map((v, index) => (
        <li class="grid items-center gap-1 sm:grid-cols-[16rem_1fr] sm:gap-3">
          <span class:list={['truncate text-sm sm:text-base', v.est_luynes ? 'font-bold text-ink' : 'text-ink-2']}>
            {v.nom}
            {!v.est_luynes && <span class="hidden text-xs text-muted sm:inline"> · {formatNumber(v.distance_km, 1)} km</span>}
          </span>
          <span class="flex items-center gap-2">
            <span
              data-bar
              class:list={['bar h-7 rounded-r-[4px]', v.est_luynes ? 'bg-accent' : 'bg-bar']}
              style={`width: ${(v.population / max) * 100}%; --delay: ${index * 70}ms`}
            />
            <span class:list={['tabular shrink-0 text-sm', v.est_luynes ? 'font-bold text-ink' : 'text-ink-2']}>
              {formatNumber(v.population)}
            </span>
          </span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-4 text-sm text-muted">
    Nombre d'habitants. Voisines = les 7 communes dont le centre est le plus proche de celui de Luynes.
  </figcaption>
</figure>

<style>
  .bar {
    transform-origin: left center;
  }
  :global(html.motion) .bar {
    transform: scaleX(0);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--delay);
  }
  :global(html.motion) .bar:global(.is-visible) {
    transform: none;
  }
</style>
