---
import { formatNumber } from '../lib/format';

interface Props {
  label: string;
  value: number;
  unit?: string;
  decimals?: 0 | 1;
  note?: string;
  tone?: 'loire' | 'accent' | 'plain';
  class?: string;
}

const { label, value, unit, decimals = 0, note, tone = 'plain', class: className = '' } = Astro.props;

const toneClasses = {
  loire: 'bg-loire text-bg',
  accent: 'bg-accent-soft text-ink',
  plain: 'bg-surface text-ink',
} as const;
---

<article
  class:list={[
    'reveal group relative overflow-hidden rounded-[1.75rem] border border-line p-6 sm:p-7',
    'transition-transform duration-300 hover:-translate-y-1 hover:rotate-[-0.4deg]',
    toneClasses[tone],
    className,
  ]}
>
  <p class:list={['text-sm font-medium tracking-wide uppercase', tone === 'loire' ? 'opacity-80' : 'text-ink-2']}>
    {label}
  </p>
  <p class="mt-3 flex items-baseline gap-2 font-display leading-none">
    <span class="tabular text-5xl font-extrabold tracking-tight sm:text-6xl" data-count={value} data-decimals={decimals}>
      {formatNumber(value, decimals)}
    </span>
    {unit && <span class="text-lg font-semibold opacity-80">{unit}</span>}
  </p>
  {note && <p class:list={['mt-4 text-sm leading-snug', tone === 'loire' ? 'opacity-85' : 'text-ink-2']}>{note}</p>}
</article>
