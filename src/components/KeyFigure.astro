---
/**
 * Chiffre clé. Avec `href`, toute la carte mène au détail (accueil) ; sans `href`, simple carte (pages de thème).
 * Avec `info`, un bouton ⓘ affiche la source, le calcul et l'année du chiffre.
 * Le slot accueille un petit visuel (ex. mini-courbe).
 *
 * Lien « étiré » : le <a> recouvre toute la carte, mais le bouton ⓘ reste au-dessus et cliquable
 * (un bouton ne peut pas être placé à l'intérieur d'un lien en HTML valide).
 */
import { formatNumber } from '../lib/format';
import Icon, { type IconName } from './Icon.astro';
import InfoTip from './InfoTip.astro';
import type { Methode } from '../data/methodes';

interface Props {
  /** Petite icône au trait en haut à droite de la carte (facultative). */
  icon?: IconName;
  label: string;
  value: number;
  unit?: string;
  decimals?: 0 | 1;
  note?: string;
  tone?: 'loire' | 'accent' | 'plain';
  href?: string;
  /** Source, calcul et année du chiffre (bulle ⓘ) */
  info?: Methode;
  class?: string;
}

const { icon, label, value, unit, decimals = 0, note, tone = 'plain', href, info, class: className = '' } = Astro.props;

const toneClasses = {
  loire: 'bg-loire text-bg',
  accent: 'bg-accent-soft text-ink',
  plain: 'bg-surface text-ink',
} as const;

const soft = tone === 'loire' ? 'opacity-85' : 'text-ink-2';
---

<article
  class:list={[
    'reveal group relative flex flex-col overflow-hidden rounded-[1.75rem] border border-line p-6 sm:p-7',
    'transition duration-300 hover:-translate-y-1 hover:rotate-[-0.4deg]',
    href && 'hover:shadow-[0_18px_40px_-24px_rgba(27,42,46,0.55)] has-[.stretched-link:focus-visible]:ring-4 has-[.stretched-link:focus-visible]:ring-loire/40 has-[.stretched-link:active]:translate-y-0',
    toneClasses[tone],
    className,
  ]}
>
  {href && <a href={href} class="stretched-link absolute inset-0 z-[1] rounded-[inherit] focus-visible:outline-none" aria-label={`${label} : voir le détail`} />}
  <div class:list={['relative flex grow flex-col', href && 'pointer-events-none']}>
    <div class="flex items-start justify-between gap-3">
      <p class:list={['text-sm font-medium tracking-wide uppercase', soft]}>
        {label}
        {
          info && (
            <span class="pointer-events-auto relative z-[2] ml-1 inline-flex align-[-0.2em] normal-case">
              <InfoTip methode={info} label={label} onDark={tone === 'loire'} />
            </span>
          )
        }
      </p>
      {
        icon && (
          <span
            class:list={[
              'grid h-10 w-10 shrink-0 place-items-center rounded-full transition-transform duration-300 group-hover:rotate-[-8deg]',
              tone === 'loire' ? 'bg-bg/15' : 'bg-loire-soft text-loire',
            ]}
          >
            <Icon name={icon} class="h-5 w-5" />
          </span>
        )
      }
    </div>
    <p class="mt-3 flex items-baseline gap-2 font-display leading-none">
      <span class="figure-value text-5xl font-extrabold tracking-tight sm:text-6xl" data-count={value} data-decimals={decimals}>
        {formatNumber(value, decimals)}
      </span>
      {unit && <span class:list={['text-lg font-semibold opacity-80', unit.startsWith('ᵉ') && '-ml-2']}>{unit}</span>}
    </p>
    {note && <p class:list={['mt-4 text-sm leading-snug', soft]}>{note}</p>}
    <slot />
    {
      href && (
        <span class:list={['mt-auto pt-5 text-sm font-semibold', tone === 'loire' ? '' : 'text-loire']} aria-hidden="true">
          Voir le détail <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </span>
      )
    }
  </div>
</article>
