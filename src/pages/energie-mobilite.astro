---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import Icon from '../components/Icon.astro';
import Waffle, { type WaffleItem } from '../components/charts/Waffle.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import MiniRank from '../components/charts/MiniRank.astro';
import PictoGrid from '../components/charts/PictoGrid.astro';
import RankGauge from '../components/charts/RankGauge.astro';
import LineChart, { type LineSeries } from '../components/charts/LineChart.astro';
import { anneesEnergie, anneesParc, bornesRecharge, resumeEnergie as r, secteursEnergie, vignettesCritair } from '../data/energie';
import { CREDITS_ENERGIE } from '../data/credits';
import { formatNumber } from '../lib/format';
import { faitsEnergie } from '../lib/faits-energie';
import { methode } from '../data/methodes';
import SourcesMethode from '../components/SourcesMethode.astro';

const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';
const pourcent = (v: number): string => `${formatNumber(v, 1)} %`;
const kwh = (mwh: number): string => `${formatNumber(Math.round(mwh * 100) * 10)} kWh`;
const versus = (luynes: number, dep: number, display: (v: number) => string): MiniItem[] => [
  { label: 'Luynes', value: luynes, display: display(luynes), highlight: true },
  { label: 'Indre-et-Loire', value: dep, display: display(dep) },
];

// — Qui consomme l'énergie ? (sur 100 MWh, électricité + gaz, dernière année) —
const secteurs: WaffleItem[] = secteursEnergie.filter((s) => s.part_pct >= 0.5).map((s) => ({ label: s.secteur, value: s.part_pct }));

// — Électricité et gaz par logement, chaque année —
const xsEnergie = anneesEnergie.map((a) => a.annee);
const seriesEnergie: LineSeries[] = [
  { name: 'Électricité (kWh par logement)', color: 'var(--chart-1)', values: anneesEnergie.map((a) => Math.round(a.elec_mwh_par_logement * 1000)) },
  { name: 'Gaz (kWh par logement raccordé)', color: 'var(--chart-2)', values: anneesEnergie.map((a) => Math.round(a.gaz_mwh_par_logement * 1000)) },
];
const ticksEnergie = xsEnergie.filter((_annee, i) => i % 2 === 0 || i === xsEnergie.length - 1);

// — Voitures par motorisation, au 1er janvier de chaque année —
const xsParc = anneesParc.map((a) => a.annee);
const seriesParc: LineSeries[] = [
  { name: 'Diesel', color: 'var(--chart-2)', values: anneesParc.map((a) => a.diesel) },
  { name: 'Essence', color: 'var(--chart-1)', values: anneesParc.map((a) => a.essence) },
  { name: 'Hybrides (dont rechargeables)', color: 'var(--chart-4)', values: anneesParc.map((a) => a.hybride + a.hybride_rechargeable) },
  { name: 'Électriques', color: 'var(--chart-3)', values: anneesParc.map((a) => a.electrique) },
];
const ticksParc = xsParc.filter((a) => a % 5 === 0 || a === xsParc.at(-1));

// — Vignettes Crit'Air regroupées en 4 familles (sur 100 voitures) —
const partDe = (vignettes: readonly string[], cle: 'part_luynes' | 'part_37'): number =>
  vignettesCritair.filter((v) => vignettes.includes(v.vignette)).reduce((s, v) => s + v[cle], 0);
const familles = [
  { label: "Crit'Air E ou 1 (électriques, essence récentes, hybrides)", vignettes: ['E', '1'] },
  { label: "Crit'Air 2", vignettes: ['2'] },
  { label: "Crit'Air 3", vignettes: ['3'] },
  { label: "Crit'Air 4, 5 ou non classées", vignettes: ['4', '5', 'Non classé', 'Inconnu'] },
];
const critair: WaffleItem[] = familles.map((f) => ({ label: f.label, value: partDe(f.vignettes, 'part_luynes') }));
const propres = { luynes: partDe(['E', '1'], 'part_luynes'), dep: partDe(['E', '1'], 'part_37') };
const borne = bornesRecharge[0];
---

<Base
  title="Énergie et mobilité à Luynes — Luynes en chiffres"
  description={`Électricité, gaz, panneaux solaires, voitures électriques et bornes de recharge : l'énergie et la mobilité à Luynes, comparées à l'Indre-et-Loire.`}
  sources={CREDITS_ENERGIE}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="eclair" class="h-5 w-5" /> Thème · Énergie & mobilité</p>
    <h1 id="titre" class="mt-3 font-display text-[2.6rem] leading-[0.95] font-extrabold tracking-tight min-[380px]:text-5xl sm:text-8xl">
      Énergie <span class="text-accent">&</span> mobilité
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      Combien d'électricité et de gaz consomment les Luynois, combien de panneaux solaires sont raccordés, et avec quelles
      voitures roule-t-on : les données des réseaux d'énergie et des immatriculations, pour la commune de Luynes.
    </p>
  </section>

  <section aria-label="Chiffres clés de l'énergie et de la mobilité" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <KeyFigure tone="loire" icon="voiture" label={`Voitures électriques (${r.annee_parc})`} value={r.part_electrique_pct} decimals={1} unit="%" info={methode('voitures_electriques')}>
      <MiniRank onDark rank={r.rang_electrique} total={r.nb_communes_parc} what="part la plus forte" />
    </KeyFigure>
    <KeyFigure tone="accent" icon="soleil" label="Puissance solaire raccordée" value={r.solaire_kw} unit="kW" info={methode('solaire')}>
      <MiniCompare items={versus(r.solaire_kw_pour_1000, r.solaire_kw_pour_1000_37, (v) => `${formatNumber(v)} kW`)} />
      <p class="mt-2 text-xs text-ink-2">pour 1 000 habitants</p>
    </KeyFigure>
    <KeyFigure icon="eclair" label={`Électricité par logement (${r.annee_energie})`} value={Math.round(r.elec_mwh_par_logement * 1000)} unit="kWh" info={methode('electricite')}>
      <MiniCompare items={versus(r.elec_mwh_par_logement, r.elec_mwh_par_logement_37, kwh)} />
    </KeyFigure>
    <KeyFigure icon="borne" label="Bornes de recharge publiques" value={r.bornes_stations} info={methode('bornes')}>
      <p class="mt-5 text-sm text-ink-2">
        {r.bornes_stations > 0 ? `${formatNumber(r.bornes_points)} points de charge dans la commune` : 'Aucune station recensée dans la commune'}
      </p>
    </KeyFigure>
  </section>

  <section id="consommation" aria-labelledby="consommation-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="consommation-titre" class={titreH2}>L'énergie consommée</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Électricité et gaz livrés par les réseaux à Luynes en {r.annee_energie} (hors bois, fioul et solaire consommé sur place).
    </p>
    <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <div class={carte}>
        <Waffle info={methode('energie_secteurs')}
          title="Sur 100 MWh consommés à Luynes"
          unit="MWh"
          items={secteurs}
          ariaLabel={`Répartition de l'électricité et du gaz consommés à Luynes en ${r.annee_energie} : ${secteurs.map((s) => `${s.label} ${formatNumber(s.value, 0)} %`).join(', ')}.`}
        />
      </div>
      <div class={carte}>
        <h3 class="flex items-center gap-2 font-display text-xl font-bold"><Icon name="flamme" class="h-6 w-6 text-accent" /> Logements chauffés au gaz ?</h3>
        <p class="mt-1 text-sm text-ink-2">Logements raccordés au gaz, sur 100 logements raccordés à l'électricité.</p>
        <div class="mt-5">
          <PictoGrid info={methode('energie_secteurs')}
            shape="maison"
            count={r.part_logements_gaz_pct}
            label="raccordés au gaz"
            ariaLabel={`${formatNumber(Math.round(r.part_logements_gaz_pct))} logements sur 100 sont raccordés au gaz à Luynes`}
          />
        </div>
        <p class="mt-5 text-sm font-medium">Gaz consommé par logement raccordé</p>
        <MiniCompare info={methode('gaz')} items={versus(r.gaz_mwh_par_logement, r.gaz_mwh_par_logement_37, kwh)} />
      </div>
    </div>
    <div class:list={['mt-6', carte]}>
      <h3 class="font-display text-xl font-bold">Par logement, année après année</h3>
      <p class="mt-1 text-sm text-ink-2">
        La consommation suit la météo (un hiver doux fait baisser le gaz) ; mieux vaut regarder la tendance que les petites variations.
      </p>
      <div class="mt-6">
        <LineChart info={methode('energie_series')}
          xs={xsEnergie}
          series={seriesEnergie}
          xTicks={ticksEnergie}
          unit="kWh"
          ariaLabel={`Consommation moyenne par logement à Luynes de ${xsEnergie[0]} à ${xsEnergie.at(-1)} : électricité et gaz, en kWh par an.`}
          tableCaption="Consommation moyenne par logement à Luynes (kWh par an)"
        />
      </div>
    </div>
  </section>

  <section id="solaire" aria-labelledby="solaire-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="solaire-titre" class={titreH2}>Le solaire</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_1.2fr]">
      <div class="flex flex-col justify-between rounded-[1.5rem] bg-accent-soft p-6 sm:p-8">
        <Icon name="soleil" class="h-9 w-9 text-accent" />
        <p class="mt-6 font-display text-6xl font-extrabold tracking-tight">{formatNumber(r.solaire_installations)}</p>
        <p class="mt-2 text-ink-2">
          installations solaires raccordées au réseau électrique, pour {formatNumber(r.solaire_kw)} kW au total
          (registre national des installations de production).
        </p>
      </div>
      <div class={carte}>
        <h3 class="font-display text-xl font-bold">Puissance solaire pour 1 000 habitants</h3>
        <MiniCompare info={methode('solaire')} items={versus(r.solaire_kw_pour_1000, r.solaire_kw_pour_1000_37, (v) => `${formatNumber(v)} kW`)} />
        <p class="mt-6 text-sm text-ink-2">
          La moyenne du département est tirée vers le haut par quelques grandes centrales solaires, de plusieurs milliers
          de kW chacune, dans des communes peu peuplées. Les petites installations (moins de 36 kW, souvent sur les toits des maisons) sont comptées ensemble par le registre.
        </p>
      </div>
    </div>
  </section>

  <section id="voitures" aria-labelledby="voitures-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="voitures-titre" class={titreH2}>Les voitures</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Voitures particulières immatriculées à Luynes au 1er janvier de chaque année ({formatNumber(r.voitures)} en {r.annee_parc}), par motorisation.
    </p>
    <div class:list={['mt-8', carte]}>
      <LineChart info={methode('parc_voitures')}
        xs={xsParc}
        series={seriesParc}
        xTicks={ticksParc}
        unit="voitures"
        ariaLabel={`Voitures de Luynes par motorisation de ${xsParc[0]} à ${xsParc.at(-1)} : le diesel passe de ${formatNumber(anneesParc[0]?.diesel ?? 0)} à ${formatNumber(anneesParc.at(-1)?.diesel ?? 0)}, l'électrique de ${formatNumber(anneesParc[0]?.electrique ?? 0)} à ${formatNumber(anneesParc.at(-1)?.electrique ?? 0)}.`}
        tableCaption="Voitures particulières immatriculées à Luynes par motorisation"
      />
    </div>
    <div class="mt-6 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <div class={carte}>
        <Waffle info={methode('parc_voitures')}
          title={`Sur 100 voitures à Luynes (${r.annee_parc})`}
          unit="voitures"
          items={critair}
          ariaLabel={`Vignettes Crit'Air des voitures de Luynes : ${critair.map((c) => `${c.label} ${formatNumber(c.value, 0)} %`).join(', ')}.`}
        />
      </div>
      <div class={carte}>
        <h3 class="font-display text-xl font-bold">Les moins polluantes (Crit'Air E ou 1)</h3>
        <MiniCompare info={methode('parc_voitures')} items={versus(propres.luynes, propres.dep, pourcent)} />
        <h3 class="mt-8 font-display text-xl font-bold">Le diesel</h3>
        <MiniCompare info={methode('parc_voitures')}
          items={[
            { label: `Luynes ${r.annee_parc_debut}`, value: r.part_diesel_debut_pct, display: pourcent(r.part_diesel_debut_pct) },
            { label: `Luynes ${r.annee_parc}`, value: r.part_diesel_pct, display: pourcent(r.part_diesel_pct), highlight: true },
            { label: `37 en ${r.annee_parc}`, value: r.part_diesel_37_pct, display: pourcent(r.part_diesel_37_pct) },
          ]}
        />
      </div>
    </div>
  </section>

  <section id="recharge" aria-labelledby="recharge-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="recharge-titre" class={titreH2}>Recharger sa voiture</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Bornes publiques recensées dans la base nationale, situées à l'intérieur de la commune.</p>
    {
      borne ? (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {bornesRecharge.map((b) => (
            <li class:list={[carte, 'flex items-start gap-4']}>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name="borne" class="h-6 w-6" /></span>
              <span>
                <span class="block font-display text-xl font-bold">{b.adresse.replace(/,?\s*37230 Luynes.*$/i, '')}</span>
                <span class="mt-1 block text-sm text-ink-2">
                  {formatNumber(b.points_de_charge)} points de charge · {b.implantation.toLowerCase()}
                  {b.puissance_max_kw > 0 && ` · jusqu'à ${formatNumber(b.puissance_max_kw)} kW`}
                </span>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class:list={['mt-8', carte]}>Aucune borne publique n'est recensée dans la commune.</p>
      )
    }
  </section>

  <section id="departement" aria-labelledby="departement-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="departement-titre" class={titreH2}>Luynes dans le département</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <RankGauge info={methode('voitures_electriques')} label="Part de voitures électriques" rank={r.rang_electrique} total={r.nb_communes_parc} icon="voiture" ends={['la plus forte', 'la plus faible']} />
      <RankGauge info={methode('solaire')} label="Solaire par habitant" rank={r.rang_solaire} total={r.nb_communes} icon="soleil" ends={['le plus', 'le moins']} />
      <RankGauge info={methode('electricite')} label="Électricité par logement" rank={r.rang_elec} total={r.nb_communes_elec} icon="eclair" ends={['la plus forte', 'la plus faible']} />
    </div>
    {
      r.elec_mwh_par_logement > r.elec_mwh_par_logement_37 && r.rang_elec > r.nb_communes_elec / 2 && (
        <p class="mt-4 max-w-2xl text-sm text-ink-2">
          Électricité : Luynes consomme plus que la moyenne du département par logement, mais se classe dans la seconde moitié
          des communes. Ce n'est pas contradictoire : la moyenne du département est tirée vers le bas par les nombreux
          appartements de Tours, alors que la plupart des communes, faites surtout de maisons, consomment davantage que Luynes.
        </p>
      )
    }
  </section>

  <FunFacts facts={faitsEnergie()} id="saviez-vous-energie" />
  <SourcesMethode page="energie-mobilite" />
</Base>
