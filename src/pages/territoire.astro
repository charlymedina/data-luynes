---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import Icon from '../components/Icon.astro';
import RankSkyline from '../components/charts/RankSkyline.astro';
import RankGauge from '../components/charts/RankGauge.astro';
import CompareBars, { type CompareItem } from '../components/charts/CompareBars.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import { commune, communesDepartement, rang } from '../data/commune';
import { CREDITS_TERRITOIRE } from '../data/credits';
import { formatCommunes, formatNumber, formatRankOf } from '../lib/format';
import { methode } from '../data/methodes';
import SourcesMethode from '../components/SourcesMethode.astro';
import { faitsCommune } from '../lib/faits';

const plusDense = communesDepartement[0];
const moinsDense = communesDepartement.at(-1);
const enKm2 = (v: number): string => `${formatNumber(v, 1)} km²`;
const enDensite = (v: number): string => `${formatNumber(v)} hab./km²`;
const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';

const superficies: CompareItem[] = [
  { label: 'Luynes', value: commune.surface_km2, display: enKm2(commune.surface_km2), highlight: true },
  { label: 'Moyenne des communes du 37', value: rang.surface_moyenne_km2, display: enKm2(rang.surface_moyenne_km2), highlight: false },
  { label: 'Médiane des communes du 37', value: rang.surface_mediane_km2, display: enKm2(rang.surface_mediane_km2), highlight: false },
];
const densites: CompareItem[] = [
  { label: 'Luynes', value: commune.densite_hab_km2, display: enDensite(commune.densite_hab_km2), highlight: true },
  { label: 'Indre-et-Loire', value: rang.densite_departement, display: enDensite(rang.densite_departement), highlight: false },
];
const mini = (items: CompareItem[], display: (v: number) => string): MiniItem[] =>
  items.map((i) => ({ label: i.label, value: i.value, display: display(i.value), highlight: i.highlight }));
---

<Base
  title="Territoire de Luynes — Luynes en chiffres"
  description={`${formatNumber(commune.surface_km2, 1)} km², ${formatNumber(commune.densite_hab_km2)} habitants au km² : la place de Luynes parmi les ${formatCommunes(rang.nb_communes)}.`}
  sources={CREDITS_TERRITOIRE}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="carte" class="h-5 w-5" /> Thème · Territoire</p>
    <h1 id="titre" class="mt-3 font-display text-5xl leading-[0.95] font-extrabold tracking-tight min-[380px]:text-6xl sm:text-8xl">Territoire</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      Grande ou petite, dense ou aérée : comment Luynes se situe parmi les communes d'Indre-et-Loire.
    </p>
  </section>

  <section aria-label="Chiffres clés du territoire" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <KeyFigure tone="loire" icon="regle" label="Superficie" value={commune.surface_km2} decimals={1} unit="km²" info={methode('superficie')}>
      <MiniCompare onDark items={mini(superficies.slice(0, 2), enKm2)} />
    </KeyFigure>
    <KeyFigure tone="accent" icon="immeuble" label="Densité" value={commune.densite_hab_km2} unit="hab./km²" info={methode('densite')}>
      <MiniCompare items={mini(densites, (v) => formatNumber(v))} />
    </KeyFigure>
    <RankGauge label="Rang en densité" rank={rang.rang_densite} total={rang.nb_communes} icon="immeuble" ends={['la plus dense', 'la moins dense']} />
    <RankGauge label="Rang en superficie" rank={rang.rang_surface} total={rang.nb_communes} icon="regle" ends={['la plus grande', 'la plus petite']} />
  </section>

  <section id="densite" aria-labelledby="densite-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="densite-titre" class={titreH2}>Les {formatCommunes(rang.nb_communes)}, de la plus dense à la moins dense</h2>
    {
      plusDense && moinsDense && (
        <p class="mt-4 max-w-2xl text-ink-2">
          Chaque colonne est une commune : de {plusDense.nom}, tout en haut, à {moinsDense.nom}, tout au bout. Luynes arrive {formatRankOf(rang.rang_densite, rang.nb_communes)}.
        </p>
      )
    }
    <div class:list={['mt-8', carte]}>
      <RankSkyline
        communes={communesDepartement}
        ariaLabel={`Densité des ${rang.nb_communes} communes d'Indre-et-Loire, de la plus dense à la moins dense. Luynes est ${formatRankOf(rang.rang_densite, rang.nb_communes)} avec ${formatNumber(commune.densite_hab_km2)} habitants au km².`}
      />
    </div>
  </section>

  <section id="comparaison" aria-labelledby="comparaison-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="comparaison-titre" class={titreH2}>Luynes face au département</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class={carte}>
        <CompareBars title="Superficie" items={superficies} />
        <p class="mt-4 text-sm text-ink-2">« Médiane » : la moitié des communes d'Indre-et-Loire sont plus petites, l'autre moitié plus grandes.</p>
      </div>
      <div class={carte}>
        <CompareBars title="Habitants au km²" items={densites} />
        <p class="mt-4 text-sm text-ink-2">Densité du département = tous ses habitants divisés par toute sa superficie.</p>
      </div>
    </div>
  </section>

  <FunFacts facts={faitsCommune()} id="saviez-vous-territoire" />
  <SourcesMethode page="territoire" />
</Base>
