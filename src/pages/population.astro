---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import LineChart from '../components/charts/LineChart.astro';
import AgePyramid from '../components/charts/AgePyramid.astro';
import CompareBars, { type CompareItem } from '../components/charts/CompareBars.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import MiniRank from '../components/charts/MiniRank.astro';
import PictoGrid from '../components/charts/PictoGrid.astro';
import RankGauge from '../components/charts/RankGauge.astro';
import { rang } from '../data/commune';
import { ages, agesDe, evolutionAges, faits, historique, naissancesDeces, pyramide } from '../data/population';
import { CREDITS_POPULATION } from '../data/credits';
import { formatCommunes, formatNumber, formatPercent } from '../lib/format';
import { faitsPopulation, formatVariation } from '../lib/faits';
import { methode } from '../data/methodes';
import SourcesMethode from '../components/SourcesMethode.astro';

const luynes = agesDe('Luynes');
const departement = agesDe('Indre-et-Loire');
const france = agesDe('France');
const anneeRecensement = luynes.annee;
const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';

// — Histoire : graduations tous les 25 ans entre la première et la dernière année —
const years = historique.map((r) => r.annee);
const firstYear = years[0] ?? 0;
const lastYear = years.at(-1) ?? 0;
const QUARTER_CENTURY = 25;
const historyTicks = [
  firstYear,
  ...Array.from({ length: 8 }, (_, i) => 1900 + i * QUARTER_CENTURY).filter((y) => y > firstYear + 10 && y < lastYear - 10),
  lastYear,
];
const population1968 = historique.find((r) => r.annee === 1968)?.population;
const jalons: { icon: IconName; titre: string; valeur: string; detail: string }[] = [
  { icon: 'graphique', titre: 'Le creux', valeur: String(faits.annee_creux), detail: `${formatNumber(faits.population_creux)} habitants` },
  { icon: 'maison', titre: 'Le grand boom', valeur: `+${formatNumber(faits.hausse_par_an)}/an`, detail: `de ${faits.hausse_annee_debut} à ${faits.hausse_annee_fin}` },
  { icon: 'personnes', titre: 'Le record', valeur: String(faits.annee_pic), detail: `${formatNumber(faits.population_pic)} habitants` },
];

// — Âges : Luynes, département, France —
const trio = (pick: (row: (typeof ages)[number]) => number, display: (v: number) => string): MiniItem[] =>
  [luynes, departement, france].map((row) => ({
    label: row.territoire === 'Indre-et-Loire' ? 'Indre-et-L.' : row.territoire,
    value: pick(row),
    display: display(pick(row)),
    highlight: row.territoire === 'Luynes',
  }));
const compare = (pick: (row: (typeof ages)[number]) => number, display: (v: number) => string): CompareItem[] =>
  ages.map((row) => ({ label: row.territoire, value: pick(row), display: display(pick(row)), highlight: row.territoire === 'Luynes' }));
const enAns = (v: number): string => `${formatNumber(v, 1)} ans`;
const evolutionDebut = evolutionAges[0];
const evolutionFin = evolutionAges.at(-1);
const vieillit = !!evolutionDebut && !!evolutionFin && evolutionFin.part_65_plus > evolutionDebut.part_65_plus;

// — Naissances et décès —
const etatCivilYears = naissancesDeces.map((r) => r.annee);
const etatCivilFirst = etatCivilYears[0] ?? 0;
const etatCivilLast = etatCivilYears.at(-1) ?? 0;
// Une graduation tous les 4 ans + la dernière année (sauf si elle colle à la précédente).
const TICK_STEP = 4;
const etatCivilTicks = etatCivilYears.filter(
  (y) => (y - etatCivilFirst) % TICK_STEP === 0 || (y === etatCivilLast && (y - etatCivilFirst) % TICK_STEP >= TICK_STEP / 2),
);
const totalNaissances = naissancesDeces.reduce((sum, r) => sum + r.naissances, 0);
const totalDeces = naissancesDeces.reduce((sum, r) => sum + r.deces, 0);
// Entre les deux derniers recensements : le solde naturel, la variation réelle, et donc les arrivées nettes.
const soldeNaturelPeriode = naissancesDeces
  .filter((r) => r.annee >= faits.annee_precedente && r.annee < faits.annee_derniere)
  .reduce((sum, r) => sum + r.solde_naturel, 0);
const variationPopulation = faits.population_derniere - faits.population_precedente;
const arriveesNettes = variationPopulation - soldeNaturelPeriode;
const signe = (v: number): string => (v > 0 ? `+${formatNumber(v)}` : formatNumber(v));
const bilan: { icon: IconName; titre: string; valeur: number }[] = [
  { icon: 'bebe', titre: 'Naissances moins décès', valeur: soldeNaturelPeriode },
  { icon: 'maison', titre: 'Arrivées moins départs', valeur: arriveesNettes },
  { icon: 'personnes', titre: 'Au total', valeur: variationPopulation },
];
---

<Base
  title="Population de Luynes — Luynes en chiffres"
  description={`${formatNumber(faits.population_derniere)} habitants, ${formatNumber(luynes.age_median, 1)} ans d'âge médian : la population de Luynes depuis ${firstYear}.`}
  sources={CREDITS_POPULATION}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="personnes" class="h-5 w-5" /> Thème · Population</p>
    <h1 id="titre" class="mt-3 font-display text-5xl leading-[0.95] font-extrabold tracking-tight min-[380px]:text-6xl sm:text-8xl">Population</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      L'histoire de Luynes racontée par les recensements depuis {firstYear}, la pyramide des âges et l'état civil.
    </p>
  </section>

  <section aria-label="Chiffres clés de la population" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <KeyFigure tone="loire" icon="personnes" label={`Habitants en ${lastYear}`} value={faits.population_derniere} info={methode('population')}>
      <MiniRank onDark rank={rang.rang_population} total={rang.nb_communes} what="la plus peuplée" />
    </KeyFigure>
    <KeyFigure icon="graphique" label="Depuis 1968" value={faits.multiplie_depuis_1968} decimals={1} unit="fois plus" info={methode('multiplie_1968')}>
      {
        population1968 !== undefined && (
          <MiniCompare
            items={[
              { label: String(lastYear), value: faits.population_derniere, display: formatNumber(faits.population_derniere), highlight: true },
              { label: '1968', value: population1968, display: formatNumber(population1968) },
            ]}
          />
        )
      }
    </KeyFigure>
    <KeyFigure tone="accent" icon="sablier" label={`Âge médian (${anneeRecensement})`} value={luynes.age_median} decimals={1} unit="ans" info={methode('age_median')}>
      <MiniCompare items={trio((r) => r.age_median, enAns)} />
    </KeyFigure>
    <KeyFigure icon="calendrier" label={`65 ans et plus (${anneeRecensement})`} value={luynes.part_65_plus} decimals={1} unit="%" info={methode('part_65')}>
      <MiniCompare items={trio((r) => r.part_65_plus, formatPercent)} />
    </KeyFigure>
  </section>

  <section id="histoire" aria-labelledby="histoire-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="histoire-titre" class={titreH2}>{lastYear - firstYear} ans de recensements</h2>
    <ol class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        jalons.map((j, i) => (
          <li class="flex items-center gap-4 rounded-[1.25rem] border border-line bg-surface p-5" style={`rotate:${i % 2 === 0 ? -0.5 : 0.5}deg`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name={j.icon} class="h-6 w-6" /></span>
            <span>
              <span class="block text-xs font-semibold tracking-wide text-ink-2 uppercase">{j.titre}</span>
              <span class="tabular block font-display text-3xl font-extrabold tracking-tight">{j.valeur}</span>
              <span class="block text-sm text-ink-2">{j.detail}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <div class:list={['mt-6', carte]}>
      <LineChart info={methode('population_historique')}
        xs={years}
        series={[{ name: 'Habitants', color: 'var(--chart-1)', values: historique.map((r) => r.population) }]}
        xTicks={historyTicks}
        area
        unit="habitants"
        ariaLabel={`Population de Luynes à chaque recensement, de ${firstYear} à ${lastYear}`}
        tableCaption="Population de Luynes à chaque recensement"
        annotations={[
          { x: faits.annee_creux, y: faits.population_creux, label: `${faits.annee_creux} : ${formatNumber(faits.population_creux)}` },
          { x: faits.annee_pic, y: faits.population_pic, label: `Record : ${formatNumber(faits.population_pic)}` },
        ]}
      />
    </div>
  </section>

  <section id="ages" aria-labelledby="ages-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="ages-titre" class={titreH2}>{vieillit ? "Une commune qui prend de l'âge" : 'La pyramide des âges'}</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-[3fr_2fr]">
      <div class={carte}>
        <h3 class="mb-4 font-display text-xl font-bold">Pyramide des âges, {anneeRecensement}</h3>
        <AgePyramid info={methode('pyramide')} tranches={pyramide} />
        <p class="mt-3 text-xs text-muted">Le haut de la pyramide est probablement gonflé par les résidents de l'EHPAD et des unités de long séjour du centre hospitalier Jean-Pagès, comptés comme habitants.</p>
      </div>
      <div class="flex flex-col gap-6">
        <div class={carte}>
          <PictoGrid info={methode('part_65')}
            count={luynes.part_65_plus}
            label="habitants ont 65 ans ou plus"
            ariaLabel={`${formatNumber(Math.round(luynes.part_65_plus))} habitants sur 100 ont 65 ans ou plus à Luynes`}
          />
        </div>
        {
          evolutionDebut && evolutionFin && (
            <div class={carte}>
              <h3 class="flex items-center gap-2 font-display text-lg font-bold">
                <Icon name="calendrier" class="h-5 w-5 text-loire" /> En {evolutionFin.annee - evolutionDebut.annee} ans
              </h3>
              <p class="mt-1 text-sm text-ink-2">Part des 65 ans et plus, et des moins de 20 ans.</p>
              <MiniCompare info={methode('evolution_ages')}
                items={[
                  { label: `65+ · ${evolutionDebut.annee}`, value: evolutionDebut.part_65_plus, display: formatPercent(evolutionDebut.part_65_plus) },
                  { label: `65+ · ${evolutionFin.annee}`, value: evolutionFin.part_65_plus, display: formatPercent(evolutionFin.part_65_plus), highlight: true },
                  { label: `−20 · ${evolutionDebut.annee}`, value: evolutionDebut.part_moins_20, display: formatPercent(evolutionDebut.part_moins_20) },
                  { label: `−20 · ${evolutionFin.annee}`, value: evolutionFin.part_moins_20, display: formatPercent(evolutionFin.part_moins_20), highlight: true },
                ]}
              />
            </div>
          )
        }
      </div>
    </div>
    <div class:list={['mt-6 grid gap-6 md:grid-cols-3', carte]}>
      <CompareBars info={methode('age_median')} title="Âge médian" items={compare((r) => r.age_median, enAns)} />
      <CompareBars info={methode('part_65')} title="Part des 65 ans et plus" items={compare((r) => r.part_65_plus, formatPercent)} />
      <CompareBars info={methode('part_moins_20')} title="Part des moins de 20 ans" items={compare((r) => r.part_moins_20, formatPercent)} />
    </div>
    <p class="mt-3 text-xs text-ink-2">« France » : France entière, outre-mer compris. Âge médian estimé à partir des tranches d'âge du recensement.</p>
  </section>

  <section id="naissances" aria-labelledby="naissances-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="naissances-titre" class={titreH2}>Naissances et décès</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Chaque année depuis {etatCivilFirst}, les naissances et les décès d'habitants de Luynes.</p>
    {
      totalDeces > totalNaissances && (
        <aside class="mt-6 flex max-w-3xl items-start gap-4 rounded-[1.25rem] border-l-4 border-loire bg-loire-soft/60 p-5 text-sm text-ink-2">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-surface text-loire"><Icon name="alerte" class="h-5 w-5" /></span>
          <p>
            <strong class="text-ink">Pourquoi autant de décès ?</strong> Probablement parce que Luynes accueille un EHPAD et des
            unités de long séjour (centre hospitalier Jean-Pagès) : leurs résidents, souvent très âgés, sont comptés comme habitants
            de la commune. Cela expliquerait aussi le grand nombre de personnes de 90 ans et plus dans la pyramide des âges.
          </p>
        </aside>
      )
    }
    <div class:list={['mt-8', carte]}>
      <LineChart info={methode('naissances')}
        xs={etatCivilYears}
        series={[
          { name: 'Naissances', color: 'var(--chart-1)', values: naissancesDeces.map((r) => r.naissances) },
          { name: 'Décès', color: 'var(--chart-2)', values: naissancesDeces.map((r) => r.deces) },
        ]}
        xTicks={etatCivilTicks}
        heightClass="h-56 sm:h-72"
        ariaLabel={`Naissances et décès d'habitants de Luynes par année, de ${etatCivilFirst} à ${etatCivilLast} : ${formatNumber(totalNaissances)} naissances et ${formatNumber(totalDeces)} décès au total`}
        tableCaption="Naissances et décès d'habitants de Luynes par année"
      />
    </div>
    {
      soldeNaturelPeriode < 0 && arriveesNettes > 0 && (
        <div class="mt-8">
          <h3 class="font-display text-2xl font-bold">
            {variationPopulation < 0 ? 'Les arrivées compensent presque les décès' : 'Les arrivées font plus que compenser les décès'}
          </h3>
          <p class="mt-1 text-sm text-ink-2">Bilan entre les recensements de {faits.annee_precedente} et {faits.annee_derniere}, en habitants.</p>
          <ul class="mt-5 grid gap-4 sm:grid-cols-3">
            {bilan.map((b, i) => (
              <li class:list={['flex items-center gap-4 rounded-[1.25rem] border border-line p-5', i === 2 ? 'bg-accent-soft' : 'bg-surface']}>
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name={b.icon} class="h-6 w-6" /></span>
                <span>
                  <span class="block text-sm text-ink-2">{b.titre}</span>
                  <span class="tabular block font-display text-3xl font-extrabold text-ink">{signe(b.valeur)}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section id="departement" aria-labelledby="departement-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="departement-titre" class={titreH2}>Luynes parmi les {formatCommunes(rang.nb_communes)}</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Le point orange situe Luynes, de la valeur la plus élevée à la plus faible.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <RankGauge info={methode('rang_population')} label="Population" rank={rang.rang_population} total={rang.nb_communes} icon="personnes" ends={['la plus peuplée', 'la moins peuplée']} />
      <div class="flex flex-col">
        <RankGauge info={methode('rang_croissance')} label={`Croissance ${rang.annee_debut}-${rang.annee_fin}`} rank={rang.rang_evolution} total={rang.nb_communes} icon="graphique" ends={['la plus forte', 'la plus faible']} />
        <div class="-mt-3 flex flex-wrap gap-2 rounded-b-[1.25rem] border border-t-0 border-line bg-surface px-5 pt-4 pb-5 text-sm">
          <span class="rounded-full bg-accent-soft px-3 py-1"><strong class="tabular">{formatVariation(rang.evolution_pct)}</strong> Luynes</span>
          <span class="rounded-full bg-chart-grid px-3 py-1"><strong class="tabular">{formatVariation(rang.evolution_departement_pct)}</strong> Indre-et-Loire</span>
        </div>
      </div>
      <div class="flex flex-col">
        <RankGauge info={methode('part_65')} label="Part des 65 ans et plus" rank={rang.rang_65_plus} total={rang.nb_communes} icon="calendrier" />
        <div class="-mt-3 rounded-b-[1.25rem] border border-t-0 border-line bg-surface px-5 pt-1 pb-5">
          <MiniCompare
            items={[
              { label: 'Luynes', value: luynes.part_65_plus, display: formatPercent(luynes.part_65_plus), highlight: true },
              { label: 'Indre-et-L.', value: rang.part_65_plus_departement, display: formatPercent(rang.part_65_plus_departement) },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <FunFacts facts={faitsPopulation()} id="saviez-vous-population" />
  <SourcesMethode page="population" />
</Base>
