---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import ColumnChart, { type Column } from '../components/charts/ColumnChart.astro';
import WarmingStripes from '../components/charts/WarmingStripes.astro';
import { MOIS_COURTS, MOIS_LONGS, anneesClimat, decenniesClimat, formatJour, moisClimat, resumeClimat as r } from '../data/climat';
import { CREDITS_CLIMAT } from '../data/credits';
import { formatNumber } from '../lib/format';
import { faitsClimat } from '../lib/faits-climat';

const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';
const avant = `${r.avant_debut}-${r.avant_fin}`;
const recent = `${r.recent_debut}-${r.recent_fin}`;

/** « Avant / aujourd'hui » : deux barres fines, la période récente mise en avant. */
const avantApres = (vAvant: number, vRecent: number, display: (v: number) => string): MiniItem[] => [
  { label: avant, value: vAvant, display: display(vAvant) },
  { label: recent, value: vRecent, display: display(vRecent), highlight: true },
];
const degres = (v: number): string => `${formatNumber(v, 1)} °C`;
const jours = (v: number): string => `${formatNumber(v)} j`;

const decennie = (d: { decennie: number; nb_annees: number }): string => `années ${d.decennie}${d.nb_annees < 10 ? ` (${d.nb_annees} ans)` : ''}`;
const colonnesChaleur: Column[] = decenniesClimat.map((d, i) => ({
  label: `${String(d.decennie).slice(2)}s`,
  fullLabel: decennie(d),
  value: d.jours_chaleur,
  display: formatNumber(d.jours_chaleur, 1),
  highlight: i === decenniesClimat.length - 1,
}));
const colonnesGel: Column[] = decenniesClimat.map((d, i) => ({
  label: `${String(d.decennie).slice(2)}s`,
  fullLabel: decennie(d),
  value: d.jours_gel,
  display: formatNumber(d.jours_gel),
  highlight: i === decenniesClimat.length - 1,
}));
const plusArrose = Math.max(...moisClimat.map((m) => m.pluie));
const colonnesPluie: Column[] = moisClimat.map((m) => ({
  label: MOIS_COURTS[m.mois - 1] ?? '',
  fullLabel: MOIS_LONGS[m.mois - 1] ?? '',
  value: m.pluie,
  display: formatNumber(m.pluie),
  highlight: m.pluie === plusArrose,
}));
const plusChaud = moisClimat.reduce((a, b) => (b.temperature_max > a.temperature_max ? b : a));
const plusFroid = moisClimat.reduce((a, b) => (b.temperature_min < a.temperature_min ? b : a));

const records: { icon: IconName; titre: string; valeur: string; jour: string; ton: string }[] = [
  { icon: 'soleil', titre: 'Record de chaleur', valeur: degres(r.record_chaleur), jour: formatJour(r.record_chaleur_jour), ton: 'bg-accent-soft text-accent' },
  { icon: 'flocon', titre: 'Record de froid', valeur: degres(r.record_froid), jour: formatJour(r.record_froid_jour), ton: 'bg-loire-soft text-loire' },
  { icon: 'goutte', titre: 'Record de pluie en un jour', valeur: `${formatNumber(r.record_pluie)} mm`, jour: formatJour(r.record_pluie_jour), ton: 'bg-loire-soft text-loire' },
];
---

<Base
  title="Climat autour de Luynes — Luynes en chiffres"
  description={`Le climat mesuré à Tours depuis ${r.premiere_annee_mesures} : +${formatNumber(r.rechauffement, 1)} °C, records de chaleur et de froid, jours de gel et de forte chaleur, pluie mois par mois.`}
  sources={CREDITS_CLIMAT}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="meteo" class="h-5 w-5" /> Thème · Climat</p>
    <h1 id="titre" class="mt-3 font-display text-5xl leading-[0.95] font-extrabold tracking-tight min-[380px]:text-6xl sm:text-8xl">Climat</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      Il n'y a pas de station météo à Luynes : les chiffres de cette page viennent de la station Météo-France de{' '}
      <strong class="text-ink">Tours</strong> (aéroport de Parçay-Meslay), à {formatNumber(r.distance_station_km)} km,
      qui mesure températures et pluie chaque jour depuis {r.premiere_annee_mesures}. Le climat de Luynes y est très proche.
    </p>
  </section>

  <section aria-label="Chiffres clés du climat" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <KeyFigure tone="accent" icon="thermometre" label="Réchauffement depuis les années 1960" value={r.rechauffement} decimals={1} unit="°C">
      <MiniCompare items={avantApres(r.temperature_avant, r.temperature_recente, degres)} />
    </KeyFigure>
    <KeyFigure tone="loire" icon="soleil" label="Jours à 30 °C ou plus, par an" value={Math.round(r.jours_chaleur_recent)}>
      <MiniCompare onDark items={avantApres(r.jours_chaleur_avant, r.jours_chaleur_recent, jours)} />
    </KeyFigure>
    <KeyFigure icon="flocon" label="Jours de gel, par an" value={r.jours_gel_recent}>
      <MiniCompare items={avantApres(r.jours_gel_avant, r.jours_gel_recent, jours)} />
    </KeyFigure>
    <KeyFigure icon="goutte" label="Pluie par an" value={r.pluie_recente} unit="mm">
      <MiniCompare items={avantApres(r.pluie_avant, r.pluie_recente, (v) => `${formatNumber(v)} mm`)} />
    </KeyFigure>
  </section>

  <section id="rechauffement" aria-labelledby="rechauffement-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="rechauffement-titre" class={titreH2}>Les bandes du réchauffement</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Une bande par année, de la plus fraîche (bleu) à la plus chaude (orange), par rapport à la moyenne 1971-2000.{' '}
      {formatNumber(r.annees_recentes_dans_top10)} des 10 années les plus chaudes sont postérieures à {r.recent_debut - 1}.
    </p>
    <div class:list={['mt-8', carte]}>
      <WarmingStripes
        stripes={anneesClimat}
        reference="1971-2000"
        ariaLabel={`Température moyenne de chaque année à Tours de ${anneesClimat[0]?.annee} à ${anneesClimat.at(-1)?.annee} : les années récentes sont nettement plus chaudes, ${r.annee_plus_chaude} est la plus chaude.`}
      />
    </div>
  </section>

  <section id="decennies" aria-labelledby="decennies-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="decennies-titre" class={titreH2}>Décennie après décennie</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Nombre moyen de jours par an. En orange, la décennie en cours.</p>
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class={carte}>
        <h3 class="mb-6 flex items-center gap-2 font-display text-xl font-bold"><Icon name="soleil" class="h-6 w-6 text-accent" /> Jours à 30 °C ou plus</h3>
        <ColumnChart columns={colonnesChaleur} unit="jours par an" headers={['Décennie', 'Jours à 30 °C ou plus, par an']} ariaLabel="Jours de forte chaleur par an à Tours, par décennie" tableCaption="Jours à 30 °C ou plus par an à Tours, par décennie" />
      </div>
      <div class={carte}>
        <h3 class="mb-6 flex items-center gap-2 font-display text-xl font-bold"><Icon name="flocon" class="h-6 w-6 text-loire" /> Jours de gel</h3>
        <ColumnChart columns={colonnesGel} unit="jours par an" headers={['Décennie', 'Jours de gel par an']} ariaLabel="Jours de gel par an à Tours, par décennie" tableCaption="Jours de gel par an à Tours, par décennie" />
      </div>
    </div>
  </section>

  <section id="records" aria-labelledby="records-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="records-titre" class={titreH2}>Les records</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {
        records.map((rec) => (
          <li class={carte}>
            <span class:list={['grid h-12 w-12 place-items-center rounded-full', rec.ton]}><Icon name={rec.icon} class="h-7 w-7" /></span>
            <p class="mt-4 text-sm font-medium tracking-wide text-ink-2 uppercase">{rec.titre}</p>
            <p class="mt-1 font-display text-5xl font-extrabold tracking-tight">{rec.valeur}</p>
            <p class="mt-2 text-sm text-ink-2">le {rec.jour}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="saisons" aria-labelledby="saisons-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="saisons-titre" class={titreH2}>Au fil des mois</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Pluie moyenne de chaque mois sur 1991-2020 (la période de référence des « normales »). En orange, le mois le plus arrosé.</p>
    <div class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[2fr_1fr]">
      <div class={carte}>
        <ColumnChart columns={colonnesPluie} unit="mm" headers={['Mois', 'Pluie moyenne (mm)']} ariaLabel="Pluie moyenne de chaque mois à Tours, 1991-2020" tableCaption="Pluie moyenne mensuelle à Tours, 1991-2020" />
      </div>
      <div class="grid gap-4">
        <div class="rounded-[1.5rem] bg-accent-soft p-5 sm:p-6">
          <p class="flex items-center gap-2 text-sm font-medium tracking-wide text-ink-2 uppercase"><Icon name="soleil" class="h-5 w-5 text-accent" /> Mois le plus chaud</p>
          <p class="mt-2 font-display text-3xl font-extrabold">{MOIS_LONGS[plusChaud.mois - 1]}</p>
          <p class="mt-1 text-sm text-ink-2">{degres(plusChaud.temperature_max)} l'après-midi en moyenne</p>
        </div>
        <div class="rounded-[1.5rem] bg-loire-soft p-5 sm:p-6">
          <p class="flex items-center gap-2 text-sm font-medium tracking-wide text-ink-2 uppercase"><Icon name="flocon" class="h-5 w-5 text-loire" /> Mois le plus froid</p>
          <p class="mt-2 font-display text-3xl font-extrabold">{MOIS_LONGS[plusFroid.mois - 1]}</p>
          <p class="mt-1 text-sm text-ink-2">{degres(plusFroid.temperature_min)} au petit matin en moyenne</p>
        </div>
      </div>
    </div>
  </section>

  <FunFacts facts={faitsClimat()} id="saviez-vous-climat" />
</Base>
