---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import NeighbourBars from '../components/NeighbourBars.astro';
import { commune, rang, voisines, generatedAt } from '../data';
import { formatNumber, formatRank, formatRatio } from '../lib/format';

const plusGrandeVoisine = voisines.find((v) => !v.est_luynes);
const plusPetiteVoisine = voisines.at(-1);

const faits: string[] = [
  `Avec ${formatNumber(commune.densite_hab_km2)} habitants au km², Luynes est ${formatRatio(commune.densite_hab_km2, rang.densite_departement)} fois plus dense que la moyenne de l'Indre-et-Loire.`,
  `Luynes est la ${formatRank(rang.rang_population)} commune la plus peuplée du département… sur ${rang.nb_communes} !`,
  `En superficie, Luynes se classe ${formatRank(rang.rang_surface)} sur ${rang.nb_communes} communes d'Indre-et-Loire.`,
];
if (plusGrandeVoisine) {
  faits.push(
    `La voisine ${plusGrandeVoisine.nom}, à ${formatNumber(plusGrandeVoisine.distance_km, 1)} km, compte ${formatRatio(plusGrandeVoisine.population, commune.population)} fois plus d'habitants que Luynes.`,
  );
}
if (plusPetiteVoisine && !plusPetiteVoisine.est_luynes) {
  faits.push(
    `Il y a ${formatRatio(commune.population, plusPetiteVoisine.population)} fois plus de Luynois que d'habitants à ${plusPetiteVoisine.nom}, à ${formatNumber(plusPetiteVoisine.distance_km, 1)} km de là.`,
  );
}

const bientot = [
  { emoji: '🏠', titre: 'Immobilier', texte: 'Prix au m², ventes rue par rue (DVF).' },
  { emoji: '📈', titre: 'Population', texte: "L'évolution depuis 1968, âges, ménages." },
  { emoji: '🏫', titre: 'Équipements', texte: 'Écoles, commerces, services, santé.' },
  { emoji: '🌳', titre: 'Environnement', texte: 'Risques, nature, qualité de l’air et de l’eau.' },
];

const dateMaj = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(generatedAt);
---

<Base
  title="Luynes en chiffres — les données ouvertes de Luynes (37)"
  description={`Population, superficie, voisines… Luynes (${commune.code_postal}) racontée par les données publiques.`}
>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-4 pt-6 sm:px-6">
    <a href="/" class="group flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <img src="/favicon.svg" alt="" width="28" height="28" class="transition-transform group-hover:rotate-12" />
      luynes<span class="text-accent">·</span>data
    </a>
    <span class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-2">v0 · en construction</span>
  </header>

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- En-tête -->
    <section aria-labelledby="titre" class="relative pt-16 pb-12 sm:pt-24">
      <p class="font-medium text-loire">{commune.departement} · {commune.code_postal}</p>
      <h1 id="titre" class="mt-3 max-w-4xl font-display text-6xl leading-[0.95] font-extrabold tracking-tight sm:text-8xl">
        Luynes,<br />
        <span class="relative inline-block">
          en chiffres
          <svg class="absolute -bottom-3 left-0 w-full text-accent" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 10 C 40 2, 70 16, 110 8 S 180 2, 220 9 S 280 14, 298 6" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          </svg>
        </span>.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">
        Château, aqueduc gallo-romain, coteaux sur la Loire… et beaucoup de données publiques.
        On les rassemble ici, en clair, pour que chacun puisse découvrir sa commune autrement.
      </p>
    </section>

    <!-- Chiffres clés, composition « bento » -->
    <section aria-label="Chiffres clés" class="grid gap-4 sm:grid-cols-6">
      <KeyFigure
        class="sm:col-span-4 sm:row-span-2 sm:flex sm:flex-col sm:justify-end sm:[&_.text-5xl]:text-8xl"
        tone="loire"
        label="Habitants"
        value={commune.population}
        unit="Luynois·es"
        note={`${formatRank(rang.rang_population)} commune la plus peuplée d'Indre-et-Loire, sur ${rang.nb_communes}.`}
      />
      <KeyFigure class="sm:col-span-2" label="Superficie" value={commune.surface_km2} decimals={1} unit="km²" />
      <KeyFigure
        class="sm:col-span-2"
        tone="accent"
        label="Densité"
        value={commune.densite_hab_km2}
        unit="hab./km²"
        note={`Contre ${formatNumber(rang.densite_departement)} en moyenne dans le département.`}
      />
    </section>

    <!-- Le saviez-vous ? -->
    <section aria-labelledby="saviez-vous" class="reveal relative mt-16 sm:mt-24">
      <div class="relative rotate-[-1deg] rounded-[2rem] bg-ink p-8 text-bg shadow-[0_24px_60px_-30px_rgba(0,0,0,0.5)] sm:p-12">
        <h2 id="saviez-vous" class="font-display text-sm font-bold tracking-[0.2em] text-accent uppercase">Le saviez-vous ?</h2>
        <p id="fait" class="mt-4 min-h-[5.5rem] max-w-3xl font-display text-2xl leading-snug font-semibold sm:text-4xl" aria-live="polite">
          {faits[0]}
        </p>
        <button
          id="fait-suivant"
          type="button"
          class="mt-8 rounded-full bg-accent px-5 py-2.5 font-semibold text-ink transition hover:scale-105 hover:rotate-[-2deg] focus-visible:ring-4 focus-visible:ring-accent/40 focus-visible:outline-none active:scale-95"
        >
          Une autre ! 🎲
        </button>
      </div>
      <script is:inline type="application/json" id="faits-data" set:html={JSON.stringify(faits).replaceAll('<', '\\u003c')} />
    </section>

    <!-- Voisines -->
    <section aria-labelledby="voisines" class="reveal mt-20 grid gap-10 sm:mt-28 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 id="voisines" class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Et les voisines ?</h2>
        <p class="mt-4 text-ink-2">
          Luynes face aux communes qui l'entourent, de part et d'autre de la Loire.
          {plusGrandeVoisine && plusGrandeVoisine.population > commune.population && ` ${plusGrandeVoisine.nom} reste la grande sœur du coin.`}
        </p>
      </div>
      <div class="rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8">
        <NeighbourBars voisines={voisines} />
      </div>
    </section>

    <!-- Bientôt -->
    <section aria-labelledby="bientot" class="reveal mt-20 sm:mt-28">
      <h2 id="bientot" class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Bientôt sur le site</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          bientot.map((item, i) => (
            <li
              class="rounded-[1.25rem] border border-dashed border-line p-6 transition hover:-translate-y-1 hover:border-loire hover:bg-loire-soft"
              style={`transform: rotate(${i % 2 === 0 ? -0.6 : 0.6}deg)`}
            >
              <span class="text-3xl" aria-hidden="true">{item.emoji}</span>
              <h3 class="mt-3 font-display text-xl font-bold">{item.titre}</h3>
              <p class="mt-1 text-sm text-ink-2">{item.texte}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="mx-auto mt-24 max-w-6xl border-t border-line px-4 py-10 text-sm text-ink-2 sm:px-6">
    <p>
      <strong class="text-ink">Sources :</strong>{' '}
      <a class="underline decoration-accent underline-offset-4 hover:text-ink" href="https://geo.api.gouv.fr">API Géo</a>{' '}
      (populations légales INSEE, contours IGN) — Licence Ouverte Etalab 2.0.
    </p>
    <p class="mt-2">Données mises à jour le {dateMaj}. Site indépendant, non officiel, fait avec ❤️ à Luynes.</p>
    <p class="mt-2">
      <a class="underline decoration-accent underline-offset-4 hover:text-ink" href="https://github.com/charlymedina/data-luynes">Code source et requêtes SQL sur GitHub</a>
    </p>
  </footer>
</Base>

<script>
  const data = document.getElementById('faits-data');
  const texte = document.getElementById('fait');
  const bouton = document.getElementById('fait-suivant');
  const faits: unknown = data?.textContent ? JSON.parse(data.textContent) : [];

  if (texte && bouton && Array.isArray(faits) && faits.length > 1) {
    let index = 0;
    bouton.addEventListener('click', () => {
      index = (index + 1) % faits.length;
      texte.textContent = String(faits[index]);
    });
  } else {
    bouton?.remove();
  }
</script>
