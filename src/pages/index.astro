---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { commune, rang } from '../data/commune';
import { agesDe, derniereAnneeEtatCivil, historique } from '../data/population';
import { themesBientot } from '../data/themes';
import { CREDITS_ACCUEIL } from '../data/credits';
import { formatNumber, formatRank } from '../lib/format';
import { faitsCommune, faitsImmobilier, faitsPatrimoine, faitsPopulation } from '../lib/faits';
import { resumeRisques } from '../data/patrimoine';
import { resumeImmobilier } from '../data/immobilier';
import { toPercent } from '../lib/scale';
import { resumeBudget } from '../data/budget';
import { faitsBudget } from '../lib/faits-budget';
import { resumeRevenus } from '../data/revenus';
import { faitsRevenus } from '../lib/faits-revenus';

const luynes = agesDe('Luynes');
const france = agesDe('France');

// Mélange des anecdotes des différents thèmes (une de chaque à tour de rôle).
const sources = [faitsPopulation(), faitsCommune(), faitsPatrimoine(), faitsImmobilier(), faitsBudget(), faitsRevenus()];
const longueurMax = Math.max(...sources.map((s) => s.length));
const faits = Array.from({ length: longueurMax }, (_, i) => sources.flatMap((s) => (s[i] ? [s[i]] : []))).flat();

// Mini-courbe de la population depuis 1876 (dans la grande carte « Habitants »).
const maxPop = Math.max(...historique.map((r) => r.population));
const firstYear = historique[0]?.annee ?? 0;
const lastYear = historique.at(-1)?.annee ?? 0;
const sparkline = historique
  .map((r) => `${toPercent(r.annee, firstYear, lastYear)},${100 - toPercent(r.population, 0, maxPop)}`)
  .join(' ');
---

<Base
  title="Luynes en chiffres — les données ouvertes de Luynes (37)"
  description={`Population, âges, naissances… Luynes (${commune.code_postal}) racontée par les données publiques.`}
  sources={CREDITS_ACCUEIL}
>
  <!-- En-tête -->
  <section aria-labelledby="titre" class="relative pt-16 pb-12 sm:pt-24">
    <p class="font-medium text-loire">{commune.departement} · {commune.code_postal}</p>
    <h1 id="titre" class="mt-3 max-w-4xl font-display text-6xl leading-[0.95] font-extrabold tracking-tight sm:text-8xl">
      Luynes,<br />
      <span class="relative inline-block">
        en chiffres
        <svg class="absolute -bottom-3 left-0 w-full text-accent" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
          <path d="M2 10 C 40 2, 70 16, 110 8 S 180 2, 220 9 S 280 14, 298 6" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
        </svg>
      </span>.
    </h1>
    <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">
      Château, aqueduc gallo-romain, coteaux sur la Loire… et beaucoup de données publiques.
      On les rassemble ici, en clair, pour que chacun puisse découvrir sa commune autrement.
    </p>
  </section>

  <!-- Chiffres clés cliquables, composition « bento » -->
  <section aria-labelledby="chiffres-cles">
    <h2 id="chiffres-cles" class="sr-only">Chiffres clés</h2>
    <div class="grid gap-4 sm:grid-cols-6">
      <KeyFigure
        class="sm:col-span-4 sm:row-span-2 sm:[&_.figure-value]:text-8xl"
        tone="loire"
        href="/population"
        icon="personnes"
        label="Habitants"
        value={commune.population}
        unit="Luynois·es"
        note={`${formatRank(rang.rang_population)} commune la plus peuplée d'Indre-et-Loire, sur ${rang.nb_communes}.`}
      >
        <figure class="mt-6" aria-hidden="true">
          <svg class="h-14 w-full overflow-visible sm:h-20" viewBox="0 0 100 100" preserveAspectRatio="none">
            <polyline points={sparkline} fill="none" stroke="currentColor" stroke-opacity="0.75" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
          <figcaption class="mt-1 flex justify-between text-xs opacity-75">
            <span>{firstYear}</span><span>{lastYear}</span>
          </figcaption>
        </figure>
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-2"
        tone="accent"
        href="/population#ages"
        label="Âge médian"
        value={luynes.age_median}
        decimals={1}
        unit="ans"
        note={`Contre ${formatNumber(france.age_median, 1)} ans en France.`}
      />
      <KeyFigure
        class="sm:col-span-2"
        href="/population#naissances"
        label={`Naissances en ${derniereAnneeEtatCivil.annee}`}
        value={derniereAnneeEtatCivil.naissances}
        unit="bébés"
        note={`Et ${formatNumber(derniereAnneeEtatCivil.deces)} décès la même année.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        href="/territoire"
        label="Superficie"
        value={commune.surface_km2}
        decimals={1}
        unit="km²"
        note={`${formatRank(rang.rang_surface)} commune la plus grande d'Indre-et-Loire.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        tone="accent"
        href="/territoire#densite"
        label="Densité"
        value={commune.densite_hab_km2}
        unit="hab./km²"
        note={`Contre ${formatNumber(rang.densite_departement)} en moyenne dans le département.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        tone="loire"
        href="/patrimoine-risques#monuments"
        label="Monuments historiques"
        value={resumeRisques.monuments}
        note={`${formatRank(resumeRisques.rang_monuments)} commune d'Indre-et-Loire. Le premier protégé en ${resumeRisques.premiere_protection}.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        href="/patrimoine-risques#carte"
        label="Cavités souterraines"
        value={resumeRisques.cavites}
        note={`${formatRank(resumeRisques.rang_cavites)} commune du département : le coteau est creusé de caves.`}
      />
      <KeyFigure
        class="sm:col-span-4"
        tone="accent"
        href="/immobilier"
        icon="maison"
        label="Prix au m² d'une maison"
        value={resumeImmobilier.prix_m2_maison}
        unit="€/m²"
        note={`Contre ${formatNumber(resumeImmobilier.prix_m2_maison_37)} €/m² en Indre-et-Loire (prix médians ${resumeImmobilier.annee_debut}-${resumeImmobilier.annee_fin}).`}
      />
      <KeyFigure
        class="sm:col-span-2"
        href="/immobilier#carte"
        icon="cle"
        label="Ventes immobilières"
        value={resumeImmobilier.ventes}
        note={`Depuis ${resumeImmobilier.annee_debut}, toutes sur une carte.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        tone="loire"
        href="/budget"
        label="Dépenses de la commune"
        value={resumeBudget.depenses_hab}
        unit="€/hab."
        icon="pieces"
        note={`Budget de fonctionnement ${resumeBudget.annee}. Communes de même taille : ${formatNumber(resumeBudget.depenses_hab_strate)} € par habitant.`}
      />
      <KeyFigure
        class="sm:col-span-3"
        href="/revenus-emploi"
        icon="mallette"
        label="Niveau de vie médian"
        value={Math.round(resumeRevenus.niveau_vie / 12 / 10) * 10}
        unit="€/mois"
        note={`La moitié des Luynois vit avec plus. ${formatRank(resumeRevenus.rang_niveau_vie)} commune d'Indre-et-Loire.`}
      />
    </div>
  </section>

  <FunFacts facts={faits} />

  <ComingSoon themes={themesBientot} />
</Base>
