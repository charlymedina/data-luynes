---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import HeroAqueduc from '../components/HeroAqueduc.astro';
import SourcesMethode from '../components/SourcesMethode.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import MiniRank from '../components/charts/MiniRank.astro';
import MiniColumns from '../components/charts/MiniColumns.astro';
import { commune, rang } from '../data/commune';
import { agesDe, derniereAnneeEtatCivil, historique } from '../data/population';
import { CREDITS_ACCUEIL } from '../data/credits';
import { formatNumber, formatOneDecimal } from '../lib/format';
import { faitsCommune, faitsImmobilier, faitsPatrimoine, faitsPopulation } from '../lib/faits';
import { resumeRisques } from '../data/patrimoine';
import { annees as anneesImmobilier, resumeImmobilier } from '../data/immobilier';
import { toPercent } from '../lib/scale';
import { resumeBudget } from '../data/budget';
import { faitsBudget } from '../lib/faits-budget';
import { resumeRevenus } from '../data/revenus';
import { faitsRevenus } from '../lib/faits-revenus';
import { resumeAccidents } from '../data/accidents';
import { faitsAccidents } from '../lib/faits-accidents';
import { resumeEnergie } from '../data/energie';
import { faitsEnergie } from '../lib/faits-energie';
import { effectifsEcoles, resumeEquipements } from '../data/equipements';
import { faitsEquipements } from '../lib/faits-equipements';
import { dernierDe } from '../data/elections';
import { faitsElections } from '../lib/faits-elections';
import { indicateursDessus37, indicateursPublies, indicateursSansFait, indicateursSous37, periodeDelinquance, positionVs37 } from '../data/delinquance';
import { faitsDelinquance } from '../lib/faits-delinquance';
import { methode } from '../data/methodes';
import { resumeEau } from '../data/eau';
import { faitsEau } from '../lib/faits-eau';
import { anneesConstruction, resumeConstruction } from '../data/construction';
import { faitsConstruction } from '../lib/faits-construction';
import { faitsTransparence } from '../lib/faits-transparence';
import { comparaison, conseil } from '../data/transparence';
import { resumeSport } from '../data/sport';
import { faitsSport } from '../lib/faits-sport';
import { resumeRues } from '../data/rues';
import { faitsRues } from '../lib/faits-rues';
import { resumeBiodiversite, resumeNature } from '../data/nature';
import { faitsNature } from '../lib/faits-nature';

const luynes = agesDe('Luynes');
const france = agesDe('France');

// Mélange des anecdotes des différents thèmes (une de chaque à tour de rôle).
const sources = [faitsPopulation(), faitsCommune(), faitsPatrimoine(), faitsImmobilier(), faitsBudget(), faitsRevenus(), faitsAccidents(), faitsEquipements(), faitsEnergie(), faitsElections(), faitsDelinquance(), faitsEau(), faitsConstruction(), faitsTransparence(), faitsSport(), faitsNature(), faitsRues()];
const longueurMax = Math.max(...sources.map((s) => s.length));
const faits = Array.from({ length: longueurMax }, (_, i) => sources.flatMap((s) => (s[i] ? [s[i]] : []))).flat();

// Mini-courbe de la population depuis 1876 (dans la grande carte « Habitants »).
const maxPop = Math.max(...historique.map((r) => r.population));
const firstYear = historique[0]?.annee ?? 0;
const lastYear = historique.at(-1)?.annee ?? 0;
const sparkline = historique
  .map((r) => `${toPercent(r.annee, firstYear, lastYear)},${100 - toPercent(r.population, 0, maxPop)}`)
  .join(' ');

/** Deux ou trois barres fines : Luynes en avant, puis les références. */
const duo = (luynesValue: number, refs: readonly [string, number][], display: (v: number) => string): MiniItem[] => [
  { label: 'Luynes', value: luynesValue, display: display(luynesValue), highlight: true },
  ...refs.map(([label, value]) => ({ label, value, display: display(value) })),
];
const euros = (v: number): string => `${formatNumber(v)} €`;
const pourcent = (v: number): string => `${formatNumber(v, 1)} %`;
const presidentielle = dernierDe('pres');
const indemnitesElus = comparaison('indemnites');
const niveauVieMois = (v: number): number => Math.round(v / 12 / 10) * 10;
---

<Base
  title="Luynes en chiffres — les données ouvertes de Luynes (37)"
  description={`Population, immobilier, budget, patrimoine… Luynes (${commune.code_postal}) racontée par les données publiques.`}
  sources={CREDITS_ACCUEIL}
>
  <!-- En-tête : titre + illustration de l'aqueduc -->
  <section aria-labelledby="titre" class="relative grid items-center gap-8 pt-10 pb-12 sm:pt-16 lg:grid-cols-[1.05fr_1fr] lg:gap-6">
    <div>
      <p class="font-medium text-loire">{commune.departement} · {commune.code_postal}</p>
      <h1 id="titre" class="mt-3 max-w-4xl font-display text-6xl leading-[0.95] font-extrabold tracking-tight sm:text-8xl">
        Luynes,<br />
        <span class="relative inline-block">
          en chiffres
          <svg class="absolute -bottom-3 left-0 w-full text-accent" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 10 C 40 2, 70 16, 110 8 S 180 2, 220 9 S 280 14, 298 6" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          </svg>
        </span>.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">
        Château, aqueduc gallo-romain, coteaux sur la Loire… et beaucoup de données publiques.
        On les rassemble ici, en clair, pour que chacun puisse découvrir sa commune autrement.
      </p>
    </div>
    <div class="mx-auto w-full max-w-xl lg:max-w-none">
      <HeroAqueduc />
    </div>
  </section>

  <!-- Chiffres clés cliquables, composition « bento » : un chiffre fort + un petit visuel par carte -->
  <section aria-labelledby="chiffres-cles">
    <h2 id="chiffres-cles" class="sr-only">Chiffres clés</h2>
    <div class="grid gap-4 sm:grid-cols-6">
      <KeyFigure
        class="sm:col-span-4 sm:row-span-2 sm:[&_.figure-value]:text-8xl"
        tone="loire"
        href="/population"
        icon="personnes"
        label="Habitants"
        value={commune.population}
        unit="Luynois·es"
        info={methode('population')}
      >
        <figure class="mt-6" aria-hidden="true">
          <svg class="h-14 w-full overflow-visible sm:h-20" viewBox="0 0 100 100" preserveAspectRatio="none">
            <polyline points={sparkline} fill="none" stroke="currentColor" stroke-opacity="0.75" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
          <figcaption class="mt-1 flex justify-between text-xs opacity-75">
            <span>{firstYear}</span><span>{lastYear}</span>
          </figcaption>
        </figure>
        <MiniRank onDark rank={rang.rang_population} total={rang.nb_communes} what="la plus peuplée" />
      </KeyFigure>
      <KeyFigure class="sm:col-span-2" tone="accent" href="/population#ages" icon="sablier" label={`Âge médian (${luynes.annee})`} value={luynes.age_median} decimals={1} unit="ans" info={methode('age_median')}>
        <MiniCompare items={duo(luynes.age_median, [['France', france.age_median]], (v) => `${formatNumber(v, 1)} ans`)} />
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-2"
        href="/population#naissances"
        icon="bebe"
        label={`Naissances ${derniereAnneeEtatCivil.annee}`}
        value={derniereAnneeEtatCivil.naissances}
        unit="bébés"
        info={methode('naissances')}
      >
        <MiniCompare
          items={[
            { label: 'Naissances', value: derniereAnneeEtatCivil.naissances, display: formatNumber(derniereAnneeEtatCivil.naissances), highlight: true },
            { label: 'Décès', value: derniereAnneeEtatCivil.deces, display: formatNumber(derniereAnneeEtatCivil.deces) },
          ]}
        />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/territoire" icon="regle" label="Superficie" value={commune.surface_km2} decimals={1} unit="km²" info={methode('superficie')}>
        <MiniRank rank={rang.rang_surface} total={rang.nb_communes} what="la plus grande" />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="accent" href="/territoire#densite" icon="immeuble" label="Densité" value={commune.densite_hab_km2} unit="hab./km²" info={methode('densite')}>
        <MiniCompare items={duo(commune.densite_hab_km2, [['Indre-et-Loire', rang.densite_departement]], (v) => formatNumber(v))} />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="loire" href="/patrimoine-risques#monuments" icon="aqueduc" label="Monuments historiques" value={resumeRisques.monuments} info={methode('monuments')}>
        <MiniRank onDark rank={resumeRisques.rang_monuments} total={resumeRisques.nb_communes} what="pour les monuments" />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/patrimoine-risques#carte" icon="cave" label="Cavités souterraines" value={resumeRisques.cavites} info={methode('cavites')}>
        <MiniRank rank={resumeRisques.rang_cavites} total={resumeRisques.nb_communes} what="pour les cavités" />
      </KeyFigure>
      <KeyFigure class="sm:col-span-4" tone="accent" href="/immobilier" icon="maison" label={`Prix au m² d'une maison (${resumeImmobilier.annee_debut_prix}-${resumeImmobilier.annee_fin})`} value={resumeImmobilier.prix_m2_maison} unit="€/m²" info={methode('prix_m2_maison')}>
        <MiniCompare items={duo(resumeImmobilier.prix_m2_maison, [['Indre-et-Loire', resumeImmobilier.prix_m2_maison_37]], euros)} />
      </KeyFigure>
      <KeyFigure class="sm:col-span-2" href="/immobilier#carte" icon="cle" label={`Ventes immobilières (${resumeImmobilier.annee_debut}-${resumeImmobilier.annee_fin})`} value={resumeImmobilier.ventes} info={methode('ventes')}>
        <MiniColumns
          values={anneesImmobilier.map((a) => ({ label: String(a.annee), value: a.ventes }))}
          ariaLabel={`Ventes par année, de ${resumeImmobilier.annee_debut} à ${resumeImmobilier.annee_fin}`}
        />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="loire" href="/budget" icon="pieces" label={`Charges de fonctionnement ${resumeBudget.annee}`} value={resumeBudget.depenses_hab} unit="€/hab." info={methode('depenses')}>
        <MiniCompare onDark items={duo(resumeBudget.depenses_hab, [['Même taille', resumeBudget.depenses_hab_strate]], euros)} />
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-3"
        href="/revenus-emploi"
        icon="mallette"
        label={`Niveau de vie médian (${resumeRevenus.annee_revenus})`}
        info={methode('niveau_vie')}
        value={niveauVieMois(resumeRevenus.niveau_vie)}
        unit="€/mois"
      >
        <MiniCompare
          items={duo(
            niveauVieMois(resumeRevenus.niveau_vie),
            [
              ['Indre-et-Loire', niveauVieMois(resumeRevenus.niveau_vie_37)],
              ['France métro.', niveauVieMois(resumeRevenus.niveau_vie_france)],
            ],
            euros,
          )}
        />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="accent" href="/accidents" icon="voiture" label={`Accidents par an pour 1 000 hab. (${resumeAccidents.annee_debut}-${resumeAccidents.annee_fin})`} value={resumeAccidents.taux_luynes} decimals={1} info={methode('accidents_taux')}>
        <MiniCompare items={duo(resumeAccidents.taux_luynes, [['Indre-et-Loire', resumeAccidents.taux_37]], formatOneDecimal)} />
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-3"
        tone="loire"
        href="/energie-mobilite#voitures"
        icon="eclair"
        label={`Voitures électriques (${resumeEnergie.annee_parc})`}
        value={resumeEnergie.part_electrique_pct}
        decimals={1}
        unit="%"
        info={methode('voitures_electriques')}
      >
        <MiniCompare onDark items={duo(resumeEnergie.part_electrique_pct, [['Indre-et-Loire', resumeEnergie.part_electrique_37_pct]], (v) => `${formatNumber(v, 1)} %`)} />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/equipements" icon="boutique" label={`Commerces, services, équipements (${resumeEquipements.annee_bpe})`} value={resumeEquipements.equipements} info={methode('equipements')}>
        <MiniRank rank={resumeEquipements.rang_equipements} total={resumeEquipements.nb_communes} what="le mieux équipé par habitant" />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="accent" href="/equipements#ecoles" icon="ecole" label={`Élèves dans les écoles (${resumeEquipements.derniere_rentree})`} value={resumeEquipements.eleves} info={methode('eleves')}>
        <MiniColumns values={effectifsEcoles.map((e) => ({ label: String(e.rentree), value: e.eleves }))} ariaLabel={`Élèves des écoles de Luynes, rentrées ${resumeEquipements.premiere_rentree} à ${resumeEquipements.derniere_rentree}`} />
      </KeyFigure>
      {
        presidentielle && (
          <KeyFigure
            class="sm:col-span-3"
            tone="loire"
            href="/elections"
            icon="urne"
            label={`Participation, présidentielle ${presidentielle.annee}`}
            value={presidentielle.participation_luynes}
            decimals={1}
            unit="%"
            info={methode('participation_pres')}
          >
            <MiniCompare
              onDark
              items={duo(presidentielle.participation_luynes, [['Indre-et-Loire', presidentielle.participation_37], ['France', presidentielle.participation_france]], pourcent)}
            />
          </KeyFigure>
        )
      }
      <KeyFigure
        class="sm:col-span-3"
        href="/delinquance"
        icon="bouclier"
        label={`Indicateurs de délinquance sous la moyenne de l'Indre-et-Loire (${periodeDelinquance.debut}-${periodeDelinquance.fin})`}
        value={indicateursSous37.length}
        unit={`sur ${formatNumber(indicateursPublies.length)}`}
        info={methode('delinquance_bilan')}
      >
        <ul class="mt-5 flex gap-1" aria-hidden="true">
          {indicateursPublies.map((i) => (
            <li class:list={['h-3 flex-1 rounded-full', positionVs37(i) === 'sous' ? 'bg-loire' : 'bg-accent']} />
          ))}
        </ul>
        <p class="mt-2 text-xs text-ink-2">
          {indicateursSansFait.length > 0 && `Dont ${formatNumber(indicateursSansFait.length)} sans aucun fait. `}
          {indicateursDessus37.length > 0 && `Au-dessus : ${indicateursDessus37.map((i) => i.libelle.toLowerCase()).join(', ')}. `}
          Taux sur 3 ans, faits enregistrés par la police et la gendarmerie.
        </p>
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-3"
        tone="loire"
        href="/eau"
        icon="goutte"
        label={`Eau du robinet : prélèvements conformes (bactéries, ${resumeEau.annee_debut}-${resumeEau.annee_fin})`}
        value={resumeEau.conformes_bact}
        decimals={1}
        unit="%"
        info={methode('eau_conformite')}
      >
        <MiniCompare
          onDark
          items={duo(resumeEau.nitrates_luynes, [['Indre-et-Loire', resumeEau.nitrates_37]], (v) => `${formatOneDecimal(v)} mg/L`)}
        />
        <p class="mt-2 text-xs opacity-85">Nitrates, moyenne {resumeEau.fenetre_debut}-{resumeEau.fenetre_fin}.</p>
      </KeyFigure>
      <KeyFigure
        class="sm:col-span-3"
        href="/construction"
        icon="grue"
        label={`Logements mis en chantier (${resumeConstruction.annee_debut}-${resumeConstruction.annee_fin})`}
        value={resumeConstruction.commences_total}
        info={methode('logements_commences')}
      >
        <MiniColumns values={anneesConstruction.map((a) => ({ label: String(a.annee), value: a.commences }))} ariaLabel={`Logements commencés à Luynes par année, ${resumeConstruction.annee_debut} à ${resumeConstruction.annee_fin}`} />
        <p class="mt-2 text-xs text-ink-2">Et {formatNumber(resumeConstruction.logements_sociaux)} logements sociaux aujourd'hui.</p>
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="loire" href="/transparence#elus" icon="mairie" label={`Indemnités des élus (${indemnitesElus.annee})`} value={indemnitesElus.luynes_par_habitant} decimals={1} unit="€/hab." info={methode('elus_indemnites')}>
        <MiniCompare onDark items={duo(indemnitesElus.luynes_par_habitant, [['Même taille', indemnitesElus.strate_par_habitant], ['Médiane 37', indemnitesElus.mediane_37]], (v) => `${formatNumber(v, 1)} €`)} />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/transparence#conseil" icon="personnes" label="Conseil municipal" value={conseil.nb_elus} unit="élus" info={methode('conseil_parite')}>
        <MiniCompare items={duo(conseil.part_femmes, [['Habitants', conseil.part_femmes_population]], (v) => `${formatNumber(v, 1)} % de femmes`)} />
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="loire" href="/sport" icon="medaille" label={`Licences sportives pour 100 habitants (${resumeSport.annee_fin})`} value={resumeSport.licences_pour_100} decimals={1} info={methode('sport_licences')}>
        <MiniCompare onDark items={duo(resumeSport.licences_pour_100, [['Indre-et-Loire', resumeSport.licences_pour_100_37]], (v) => formatOneDecimal(v))} />
        <p class="mt-2 text-xs opacity-85">{formatNumber(resumeSport.licences)} licences dans {formatNumber(resumeSport.federations)} fédérations.</p>
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/sport#equipements" icon="ballon" label="Équipements sportifs pour 1 000 habitants" value={resumeSport.equipements_pour_1000} decimals={1} info={methode('sport_equipements')}>
        <MiniCompare items={duo(resumeSport.equipements_pour_1000, [['Indre-et-Loire', resumeSport.equipements_pour_1000_37]], (v) => formatOneDecimal(v))} />
        <p class="mt-2 text-xs text-ink-2">{formatNumber(resumeSport.equipements)} équipements dans {formatNumber(resumeSport.installations)} installations.</p>
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="loire" href="/nature" icon="feuille" label="De la commune en ZNIEFF ou Natura 2000" value={resumeNature.zonee_pct} decimals={1} unit="%" info={methode('nature_protege')}>
        <p class="mt-2 text-xs opacity-85">{formatNumber(resumeNature.zonee_ha)} hectares ; {formatOneDecimal(resumeNature.agricole_pct)} % de terres agricoles déclarées.</p>
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" href="/nature#biodiversite" icon="graphique" label="Espèces observées à Luynes" value={resumeBiodiversite.especes} info={methode('nature_especes')}>
        <p class="mt-2 text-xs text-ink-2">{formatNumber(resumeBiodiversite.observations)} observations partagées (GBIF).</p>
      </KeyFigure>
      <KeyFigure class="sm:col-span-3" tone="accent" href="/rues" icon="panneau" label="Noms de voies et de lieux-dits" value={resumeRues.noms} info={methode('rues_noms')}>
        <p class="mt-2 text-xs text-ink-2">{formatNumber(resumeRues.voies)} voies, {formatNumber(resumeRues.lieux_dits)} lieux-dits et {formatNumber(resumeRues.adresses)} adresses.</p>
      </KeyFigure>
    </div>
  </section>

  <FunFacts facts={faits} />
  <SourcesMethode page="accueil" />
</Base>
