---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import MapView, { type MapAreaLegendItem, type MapLegendItem } from '../components/MapView.astro';
import TimelineRows, { type TimelineRow } from '../components/charts/TimelineRows.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import MiniRank from '../components/charts/MiniRank.astro';
import RankGauge from '../components/charts/RankGauge.astro';
import Waffle from '../components/charts/Waffle.astro';
import { arretesCatnat, cavites, contourCommune, monuments, mouvementsTerrain, objetsParSiecle, objetsProteges, periodesBati, resumeBati as rb, resumeObjets as ro, resumePpri, resumeRisques as r, zoneInondable, zonesPpri } from '../data/patrimoine';
import ColumnChart, { type Column } from '../components/charts/ColumnChart.astro';
import InfoTip from '../components/InfoTip.astro';
import { CREDITS_PATRIMOINE } from '../data/credits';
import { formatCommunes, formatNumber, formatRatio } from '../lib/format';
import { methode } from '../data/methodes';
import SourcesMethode from '../components/SourcesMethode.astro';
import { faitsPatrimoine } from '../lib/faits';

/** Regroupe des événements datés par catégorie, dans l'ordre d'apparition des catégories données. */
function parCategorie<T extends { annee: number }>(items: readonly T[], categorie: (item: T) => string, ordre: readonly string[]): TimelineRow[] {
  return ordre
    .map((label) => ({ label, annees: items.filter((item) => categorie(item) === label).map((item) => item.annee) }))
    .filter((row) => row.annees.length > 0);
}

const lignesCatnat = parCategorie(arretesCatnat, (a) => a.risque, ['Sécheresse', 'Mouvement de terrain', 'Inondation / coulée de boue']);
const lignesMouvements = parCategorie(mouvementsTerrain, (m) => m.type, ['Chute de blocs / éboulement', 'Glissement', 'Effondrement / affaissement']);

const legende: MapLegendItem[] = [
  {
    label: `Cavités souterraines (${formatNumber(cavites.length)})`,
    layer: { id: 'cavites', colorVar: '--chart-1', radius: 4, points: cavites.map((c) => ({ lat: c.latitude, lon: c.longitude, label: c.type })) },
  },
  {
    label: `Monuments historiques (${formatNumber(monuments.length)})`,
    layer: {
      id: 'monuments',
      colorVar: '--chart-2',
      radius: 8,
      points: monuments.map((m) => ({ lat: m.latitude, lon: m.longitude, label: `${m.nom} — ${m.protection} en ${m.annee_protection}` })),
    },
  },
];

/** Couleurs des types de zones du PPRi, dans l'ordre du plan (lit de la Loire, derrière les digues, champ d'expansion, quartiers bâtis). */
const COULEURS_PPRI = ['--seq-5', '--seq-3', '--chart-4', '--chart-2'] as const;
const datePpri = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(resumePpri.date_approbation));

const zones: MapAreaLegendItem[] = [
  ...zonesPpri.map((z, i) => ({
    label: `PPRi : ${z.type.charAt(0).toLowerCase()}${z.type.slice(1)}`,
    area: {
      id: `ppri-${z.ordre}`,
      colorVar: COULEURS_PPRI[i] ?? '--chart-4',
      geometry: z.zone,
      label: `PPRi, ${z.type.charAt(0).toLowerCase()}${z.type.slice(1)} : ${z.regle} — ${formatNumber(z.surface_ha)} ha, ${formatNumber(z.part_commune_pct, 1)} % de la commune`,
    },
  })),
  {
    label: 'Atlas des zones inondables (TRI de Tours)',
    area: {
      id: 'zone-inondable',
      colorVar: '--chart-3',
      masquee: true,
      geometry: zoneInondable.zone,
      label: `Zone inondable de la Loire (crue de référence) : ${formatNumber(zoneInondable.surface_ha)} ha, ${formatNumber(zoneInondable.part_commune_pct, 1)} % de la commune`,
    },
  },
];

const enNombre = (v: number): string => formatNumber(v, 1);
const versus = (luynes: number, moyenne: number): MiniItem[] => [
  { label: 'Luynes', value: luynes, display: formatNumber(luynes), highlight: true },
  { label: 'Moyenne des communes du 37', value: moyenne, display: enNombre(moyenne) },
];
const comparaisons: { titre: string; icon: IconName; rank: number; items: MiniItem[] }[] = [
  { titre: 'Monuments historiques', icon: 'aqueduc', rank: r.rang_monuments, items: versus(r.monuments, r.moyenne_monuments_departement) },
  { titre: 'Cavités souterraines', icon: 'cave', rank: r.rang_cavites, items: versus(r.cavites, r.moyenne_cavites_departement) },
  { titre: 'Catastrophes naturelles reconnues', icon: 'alerte', rank: r.rang_catnat, items: versus(r.catnat, r.moyenne_catnat_departement) },
];
const typesCatnat: MiniItem[] = [
  { label: 'Sécheresse', value: r.catnat_secheresse, display: formatNumber(r.catnat_secheresse), highlight: true },
  { label: 'Terrain', value: r.catnat_mouvement, display: formatNumber(r.catnat_mouvement) },
  { label: 'Inondation', value: r.catnat_inondation, display: formatNumber(r.catnat_inondation) },
];

const colonnesSiecles: Column[] = objetsParSiecle.map((s) => ({ label: `${s.siecle}ᵉ`, fullLabel: `${s.siecle}ᵉ siècle`, value: s.objets, display: formatNumber(s.objets) }));
const premierePeriode = periodesBati[0];
const colonnesPeriodes: Column[] = periodesBati.map((p) => ({
  // Libellé court (sous la colonne) : année de début de la période, « < 1919 » pour la plus ancienne ; le libellé complet est dans l'infobulle et le tableau
  label: p.periode.startsWith('Avant') ? p.periode.replace('Avant ', '< ') : (p.periode.match(/^\d{4}/)?.[0] ?? p.periode),
  fullLabel: p.periode,
  value: p.part_batiments_pct,
  display: `${formatNumber(p.part_batiments_pct)} %`,
  highlight: p.part_batiments_pct === Math.max(...periodesBati.map((q) => q.part_batiments_pct)),
}));
const enPourcent = (v: number): string => `${formatNumber(v, 1)} %`;
const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';
---

<Base
  title="Patrimoine & risques de Luynes — Luynes en chiffres"
  description={`${formatNumber(r.monuments)} monuments historiques, ${formatNumber(r.cavites)} cavités souterraines, ${formatNumber(r.catnat)} reconnaissances de catastrophe naturelle : le patrimoine et les risques naturels de Luynes.`}
  sources={CREDITS_PATRIMOINE}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="aqueduc" class="h-5 w-5" /> Thème · Patrimoine & risques</p>
    <h1 id="titre" class="mt-3 font-display text-[2.6rem] leading-[0.95] font-extrabold tracking-tight min-[380px]:text-5xl sm:text-8xl">
      Arches <span class="text-accent">& caves</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      Un aqueduc romain, un château, des caves creusées dans le tuffeau… Le coteau qui fait le charme de Luynes
      est aussi celui qui bouge : éboulements, effondrements, sols qui travaillent pendant les sécheresses.
    </p>
  </section>

  <section aria-label="Chiffres clés du patrimoine et des risques" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <KeyFigure tone="loire" icon="aqueduc" label="Monuments historiques" value={r.monuments} info={methode('monuments')}>
      <MiniRank onDark rank={r.rang_monuments} total={r.nb_communes} what="pour les monuments" />
    </KeyFigure>
    <KeyFigure tone="accent" icon="cave" label="Cavités souterraines" value={r.cavites} info={methode('cavites')}>
      <MiniRank rank={r.rang_cavites} total={r.nb_communes} what="pour les cavités" />
    </KeyFigure>
    <KeyFigure icon="alerte" label="Catastrophes naturelles reconnues" value={r.catnat} unit="événements" note={`Reconnus par ${formatNumber(r.catnat_arretes)} arrêtés (un arrêté peut couvrir plusieurs événements).`} info={methode('catnat')}>
      <MiniCompare items={typesCatnat} />
    </KeyFigure>
    <KeyFigure icon="eboulement" label="Mouvements de terrain" value={r.mouvements} note={`Éboulements, glissements, effondrements recensés entre ${r.mouvement_plus_ancien} et ${r.mouvement_plus_recent}.`} info={methode('mouvements')} />
  </section>

  <section id="carte" aria-labelledby="carte-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="carte-titre" class={titreH2}>La carte</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Les gros points orange sont les monuments historiques, les petits points bleu-vert les cavités recensées par le BRGM,
      les zones colorées les secteurs réglementés par le plan de prévention du risque d'inondation (voir la section suivante).
      La case « Atlas des zones inondables » ajoute la zone bleue que la Loire peut recouvrir lors d'une crue de référence.
      Le pointillé marque la limite de la commune.
    </p>
    <aside class="mt-6 grid max-w-4xl gap-6 rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8 md:grid-cols-[3fr_2fr] md:items-center">
      <Waffle info={methode('zone_inondable')}
        title="Sur 100 hectares de la commune"
        unit="ha"
        colors={['var(--chart-3)', 'var(--bar)']}
        items={[
          { label: 'En zone inondable', value: zoneInondable.part_commune_pct },
          { label: 'Hors zone inondable', value: 100 - zoneInondable.part_commune_pct },
        ]}
        ariaLabel={`${formatNumber(zoneInondable.part_commune_pct, 1)} % de la commune est en zone inondable, soit ${formatNumber(zoneInondable.surface_ha)} hectares.`}
      />
      <p class="flex items-start gap-3 text-sm text-ink-2">
        <Icon name="vague" class="h-6 w-6 shrink-0 text-chart-3" />
        <span>
          La zone que la Loire peut recouvrir, entre le coteau et le fleuve : carte officielle de la crue « de probabilité moyenne »
          (qui revient en moyenne tous les 100 à 300 ans), établie pour le territoire à risque d'inondation de Tours.
        </span>
      </p>
    </aside>
    <div class="mt-8">
      <MapView info={methode('carte_patrimoine')}
        ariaLabel={`Carte de Luynes : ${formatNumber(r.monuments)} monuments historiques, ${formatNumber(r.cavites)} cavités souterraines, la zone inondable de la Loire (${formatNumber(zoneInondable.part_commune_pct, 1)} % de la commune) et les zones réglementées du PPRi (${formatNumber(resumePpri.part_commune_pct, 1)} % de la commune)`}
        contour={contourCommune}
        legend={legende}
        areas={zones}
      >
        <details class="text-sm text-ink-2">
          <summary class="cursor-pointer font-medium hover:text-ink">Voir la liste des monuments</summary>
          <ul class="mt-3 space-y-1">
            {monuments.map((m) => <li><strong class="text-ink">{m.nom}</strong> — {m.epoque}, {m.protection} en {m.annee_protection}</li>)}
          </ul>
          <p class="mt-3">Et {formatNumber(r.cavites)} cavités souterraines, presque toutes des caves (positions issues de l'inventaire du BRGM).</p>
        </details>
      </MapView>
    </div>
  </section>

  <section id="ppri" aria-labelledby="ppri-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="ppri-titre" class={titreH2}>Le plan de prévention des inondations</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Un plan de prévention du risque d'inondation (PPRi) est un document approuvé par l'État : il délimite les zones
      exposées aux crues et fixe, pour chacune, les règles à respecter pour construire ou aménager. Il s'impose aux permis
      de construire et au plan local d'urbanisme. Celui de la Loire, « Val de Tours – Val de Luynes », a été approuvé le {datePpri}.
    </p>
    <div class:list={['mt-8', carte]}>
      <div class="flex items-start justify-between gap-4">
        <h3 class="font-display text-2xl font-bold">{formatNumber(resumePpri.part_commune_pct, 1)} % de la commune est réglementée</h3>
        <InfoTip methode={methode('ppri')} label="Zones réglementées du PPRi" />
      </div>
      <p class="mt-2 text-sm text-ink-2">Soit {formatNumber(resumePpri.surface_ha)} hectares, répartis en {formatNumber(zonesPpri.length)} types de zones.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          zonesPpri.map((z, i) => (
            <li class="flex gap-3">
              <span class="mt-1.5 inline-block size-3.5 shrink-0 rounded-[3px] opacity-80" style={`background:var(${COULEURS_PPRI[i] ?? '--chart-4'})`} aria-hidden="true"></span>
              <span class="text-sm text-ink-2">
                <strong class="block text-ink">{z.type}</strong>
                {z.regle}.
                <span class="tabular block">{formatNumber(z.surface_ha)} ha · {formatNumber(z.part_commune_pct, 1)} % de la commune</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-2">
      <strong class="font-semibold text-ink">Deux cartes, deux rôles.</strong> L'atlas des zones inondables (case de la carte, ci-dessus) montre
      ce que la Loire peut recouvrir lors d'une crue de référence : il informe, sans créer de règle ({formatNumber(zoneInondable.surface_ha)} ha).
      Le PPRi est le zonage réglementaire ({formatNumber(resumePpri.surface_ha)} ha) : il tient compte de la crue de référence mais aussi
      du lit du fleuve et de la zone protégée par les digues, et il dit ce qu'il est permis de construire. Les deux ne se
      superposent donc pas exactement.
    </p>
  </section>

  <section id="monuments" aria-labelledby="monuments-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="monuments-titre" class={titreH2}>{formatNumber(r.monuments)} monuments historiques</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Du premier protégé en {r.premiere_protection} au plus récent. « Classé » est la protection la plus forte ;
      « inscrit » protège aussi l'édifice, à un niveau moindre.
    </p>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        monuments.map((m, i) => (
          <li
            class:list={['rounded-[1.25rem] border border-line p-5 transition hover:-translate-y-1', m.protection === 'classé' ? 'bg-accent-soft' : 'bg-surface']}
            style={`transform: rotate(${i % 2 === 0 ? -0.5 : 0.5}deg)`}
          >
            <p class="tabular font-display text-3xl font-extrabold text-loire">{m.annee_protection}</p>
            <h3 class="mt-2 font-display text-lg leading-tight font-bold">{m.nom}</h3>
            <p class="mt-2 text-sm text-ink-2">{m.epoque}</p>
            <p class="mt-3 text-xs font-semibold tracking-wide text-ink-2 uppercase">
              {m.protection}{m.protection_partielle ? ' (en partie)' : ''} · {m.proprietaire}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="tresors" aria-labelledby="tresors-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="tresors-titre" class={titreH2}>Les trésors cachés dans les édifices</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Au-delà des bâtiments, des meubles, statues, tableaux et vitraux sont eux aussi protégés au titre des monuments historiques.
      {formatNumber(ro.objets)} notices de la base Palissy concernent Luynes, conservées dans {formatNumber(ro.lieux)} lieux
      et protégées de {ro.premiere_protection} à {ro.derniere_protection}. Une notice décrit un objet ou un ensemble d'objets.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <KeyFigure tone="loire" icon="aqueduc" label="Objets mobiliers protégés" value={ro.objets} info={methode('objets_proteges')}>
        <p class="mt-4 text-sm opacity-90">{formatNumber(ro.classes)} classé{ro.classes > 1 ? 's' : ''} (protection la plus forte), {formatNumber(ro.objets - ro.classes)} inscrit{ro.objets - ro.classes > 1 ? 's' : ''}.</p>
      </KeyFigure>
    </div>
    <div class:list={['mt-6', carte]}>
      <p class="text-sm font-semibold">Objets protégés selon leur siècle de création</p>
      <ColumnChart info={methode('objets_siecles')}
        columns={colonnesSiecles}
        unit="objets"
        headers={['Siècle', 'Objets protégés']}
        ariaLabel={`Objets protégés de Luynes par siècle de création, du ${ro.siecle_min}e au ${ro.siecle_max}e siècle.`}
        tableCaption="Objets mobiliers protégés à Luynes par siècle de création"
      />
    </div>
    <div class="mt-6">
      <h3 class="flex items-center gap-2 font-display text-xl font-bold">La liste <InfoTip methode={methode('objets_liste')} label="Liste des objets protégés" /></h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          objetsProteges.map((o) => (
            <li class="rounded-[1.25rem] border border-line bg-surface p-5">
              <p class="text-xs font-semibold tracking-wide text-ink-2 uppercase">{o.siecle !== null ? `${o.siecle}ᵉ siècle` : 'Siècle non renseigné'}</p>
              <h4 class="mt-2 font-display text-lg leading-tight font-bold">{o.nom.charAt(0).toUpperCase() + o.nom.slice(1)}</h4>
              <p class="mt-2 text-sm text-ink-2">{o.lieu}</p>
              <p class="mt-3 text-xs font-semibold tracking-wide text-ink-2 uppercase">{o.protection} en {o.annee_protection}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="bati" aria-labelledby="bati-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="bati-titre" class={titreH2}>L'âge des maisons</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      La BD TOPO de l'IGN dessine chaque bâtiment de la commune : {formatNumber(rb.batiments)} à Luynes, dont {formatNumber(rb.residentiels)} servent (au moins en partie) d'habitation.
      Sa date de construction n'est connue que pour {formatNumber(rb.part_dates_pct)} % d'entre eux ({formatNumber(rb.part_residentiels_dates_pct)} % des habitations) :
      c'est une estimation, souvent arrondie, qui s'arrête en {rb.plus_recent_annee}. Les parts ci-dessous portent donc sur les bâtiments datés ;
      le recensement de l'INSEE, qui date tous les logements, sert de repère.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <KeyFigure tone="loire" icon="maison" label="Bâtiments cartographiés" value={rb.batiments} info={methode('bati_batiments')}>
        <p class="mt-4 text-sm opacity-90">
          Habitations datées : année médiane de construction {rb.annee_mediane_residentiels}. Le plus ancien bâtiment daté remonterait à {rb.plus_ancien_annee} (date estimée).
        </p>
      </KeyFigure>
      {
        premierePeriode && (
          <KeyFigure tone="accent" icon="immeuble" label={`Logements construits ${premierePeriode.periode.toLowerCase()}`} value={premierePeriode.part_logements_pct} decimals={1} unit="%" info={methode('bati_anciens')}>
            <MiniCompare items={[
              { label: 'Luynes', value: premierePeriode.part_logements_pct, display: enPourcent(premierePeriode.part_logements_pct), highlight: true },
              { label: 'Indre-et-Loire', value: premierePeriode.part_logements_37_pct, display: enPourcent(premierePeriode.part_logements_37_pct) },
              { label: 'France', value: premierePeriode.part_logements_france_pct, display: enPourcent(premierePeriode.part_logements_france_pct) },
            ]} />
          </KeyFigure>
        )
      }
      <KeyFigure icon="regle" label="Bâtiment le plus haut" value={rb.hauteur_max} decimals={1} unit="m" note={`Nature indiquée par l'IGN : ${rb.hauteur_max_nature.toLowerCase()}.`} info={methode('bati_hauteur')} />
    </div>
    <div class:list={['mt-6', carte]}>
      <h3 class="font-display text-xl font-bold">Quand les habitations ont-elles été construites ?</h3>
      <p class="mt-1 text-sm text-ink-2">
        Part des {formatNumber(rb.residentiels_dates)} habitations datées, par période de construction (BD TOPO) : chaque colonne porte l'année de début de sa période. La dernière période est sous-estimée : les dates s'arrêtent en {rb.plus_recent_annee}.
      </p>
      <ColumnChart info={methode('bati_periodes')}
        columns={colonnesPeriodes}
        unit="des habitations datées"
        headers={['Période de construction', 'Part des habitations datées']}
        ariaLabel={`Habitations datées de Luynes par période de construction : ${periodesBati.map((p) => `${p.periode} ${formatNumber(p.part_batiments_pct)} %`).join(', ')}.`}
        tableCaption="Habitations datées de Luynes par période de construction (BD TOPO)"
      />
    </div>
    <div class:list={['mt-6', carte]}>
      <h3 class="font-display text-xl font-bold">Le repère du recensement</h3>
      <p class="mt-1 mb-6 text-sm text-ink-2">
        Part des résidences principales de chaque période de construction, pour Luynes, l'Indre-et-Loire et la France (recensement {premierePeriode?.annee_recensement}).
      </p>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          periodesBati.map((p) => (
            <div>
              <p class="text-sm font-semibold">{p.periode}</p>
              <MiniCompare items={[
                { label: 'Luynes', value: p.part_logements_pct, display: enPourcent(p.part_logements_pct), highlight: true },
                { label: 'Indre-et-Loire', value: p.part_logements_37_pct, display: enPourcent(p.part_logements_37_pct) },
                { label: 'France', value: p.part_logements_france_pct, display: enPourcent(p.part_logements_france_pct) },
              ]} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="catastrophes" aria-labelledby="catnat-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="catnat-titre" class={titreH2}>Les catastrophes naturelles</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Chaque point est un événement reconnu « catastrophe naturelle » par l'État pour Luynes, à l'année de l'événement ({formatNumber(r.catnat)} événements, reconnus par {formatNumber(r.catnat_arretes)} arrêtés).
      Les sécheresses font « travailler » les sols argileux, ce qui peut fissurer les maisons.
    </p>
    <div class:list={['mt-8', carte]}>
      <TimelineRows info={methode('catnat')}
        rows={lignesCatnat}
        unite="événements"
        ariaLabel={`${formatNumber(r.catnat)} événements reconnus catastrophe naturelle entre ${r.catnat_premiere_annee} et ${r.catnat_derniere_annee} : ${formatNumber(r.catnat_secheresse)} pour sécheresse, ${formatNumber(r.catnat_mouvement)} pour mouvement de terrain, ${formatNumber(r.catnat_inondation)} pour inondation.`}
        tableCaption="Événements reconnus catastrophe naturelle à Luynes, par type de risque"
      />
    </div>
    <p class="mt-4 text-sm text-ink-2">
      Risques naturels officiellement recensés pour la commune : <strong class="text-ink">{r.risques_recenses}</strong>.
    </p>
  </section>

  <section id="coteau" aria-labelledby="coteau-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="coteau-titre" class={titreH2}>Le coteau qui bouge</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      {formatNumber(r.mouvements)} mouvements de terrain recensés entre {r.mouvement_plus_ancien} et {r.mouvement_plus_recent} dans l'inventaire
      du BRGM, surtout des chutes de blocs le long du coteau de tuffeau, là où sont creusées les caves. Cet inventaire
      n'est pas exhaustif et peu mis à jour : les mouvements de terrain plus récents apparaissent surtout dans les
      catastrophes naturelles ci-dessus.
    </p>
    <div class:list={['mt-8', carte]}>
      <TimelineRows info={methode('mouvements')}
        rows={lignesMouvements}
        unite="événements"
        ariaLabel={`${formatNumber(r.mouvements)} mouvements de terrain recensés à Luynes entre ${r.mouvement_plus_ancien} et ${r.mouvement_plus_recent}.`}
        tableCaption="Mouvements de terrain recensés à Luynes par type"
      />
    </div>
  </section>

  <section id="departement" aria-labelledby="departement-titre" class="reveal mt-20 scroll-mt-8 sm:mt-28">
    <h2 id="departement-titre" class={titreH2}>Luynes face au département</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Parmi les {formatCommunes(r.nb_communes)} : <strong class="text-ink">{formatRatio(r.cavites, r.moyenne_cavites_departement)} fois plus de cavités</strong> que la moyenne.
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        comparaisons.map((c) => (
          <div class="flex flex-col">
            <RankGauge info={methode(c.icon === 'aqueduc' ? 'monuments' : c.icon === 'cave' ? 'cavites' : 'catnat')} label={c.titre} rank={c.rank} total={r.nb_communes} icon={c.icon} ends={['le plus', 'le moins']} />
            <div class="-mt-3 rounded-b-[1.25rem] border border-t-0 border-line bg-surface px-5 pt-1 pb-5">
              <MiniCompare items={c.items} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <FunFacts facts={faitsPatrimoine()} id="saviez-vous-patrimoine" />
  <SourcesMethode page="patrimoine-risques" />
</Base>
