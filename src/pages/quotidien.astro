---
import Base from '../layouts/Base.astro';
import KeyFigure from '../components/KeyFigure.astro';
import FunFacts from '../components/FunFacts.astro';
import Icon from '../components/Icon.astro';
import InfoTip from '../components/InfoTip.astro';
import MapView, { type MapLegendItem } from '../components/MapView.astro';
import MiniCompare, { type MiniItem } from '../components/charts/MiniCompare.astro';
import RankGauge from '../components/charts/RankGauge.astro';
import Waffle from '../components/charts/Waffle.astro';
import SourcesMethode from '../components/SourcesMethode.astro';
import {
  anneesCovoiturage,
  dernierTrimestreFibre,
  derniereAnneeCovoiturage as cov,
  libelleTrimestre,
  pointsDeCouche,
  resumeDae as d,
  resumeFibre as f,
  resumeMobilier as m,
  trimestresFibre,
} from '../data/quotidien';
import { contourCommune } from '../data/patrimoine';
import { CREDITS_QUOTIDIEN } from '../data/credits';
import { methode } from '../data/methodes';
import { formatNumber, formatOneDecimal, formatRankOf } from '../lib/format';
import { faitsQuotidien } from '../lib/faits-quotidien';

const titreH2 = 'font-display text-4xl font-extrabold tracking-tight sm:text-5xl';
const carte = 'rounded-[1.5rem] border border-line bg-surface p-5 sm:p-8';
const pourcent = (v: number): string => `${formatOneDecimal(v)} %`;
/** Largeur d'une barre en % de la plus longue (au moins 2 % pour rester visible). */
const largeur = (v: number, max: number): string => `${Math.max(2, (100 * v) / Math.max(max, 1))}%`;
const duo = (luynes: number, ref: [string, number], affiche: (v: number) => string): MiniItem[] => [
  { label: 'Luynes', value: luynes, display: affiche(luynes), highlight: true },
  { label: ref[0], value: ref[1], display: affiche(ref[1]) },
];

// — Fibre : la part de locaux raccordables à chaque publication —
const gainPoints = f.fibre_pct - f.fibre_pct_debut;
const ENSEMBLE_VERRE = 'communes de Tours Métropole équipées';

// — Covoiturage : barres de la plus grande valeur (Luynes ou département) —
const maxCovoiturage = Math.max(...anneesCovoiturage.flatMap((a) => [a.pour_1000, a.pour_1000_37]));

// — Carte : une couche par type d'équipement —
const fiche = (libelle: string, nature: string): string => `${nature}\n${libelle}`;
const descriptions = [
  { cle: 'defibrillateurs', libelle: 'Défibrillateurs', nature: 'Défibrillateur', colorVar: '--chart-2', radius: 8 },
  { cle: 'verre', libelle: 'Apport volontaire du verre', nature: 'Point d’apport volontaire du verre', colorVar: '--chart-1', radius: 6 },
  { cle: 'textile', libelle: 'Apport volontaire du textile', nature: 'Point d’apport volontaire du textile', colorVar: '--chart-3', radius: 7 },
  { cle: 'bancs', libelle: 'Bancs publics', nature: 'Banc public', colorVar: '--chart-4', radius: 4 },
] as const;
const legende: MapLegendItem[] = descriptions
  .map((c) => ({ c, points: pointsDeCouche(c.cle) }))
  .filter(({ points }) => points.length > 0)
  .map(({ c, points }) => ({
    label: `${c.libelle} (${formatNumber(points.length)})`,
    layer: { id: `quotidien-${c.cle}`, colorVar: c.colorVar, radius: c.radius, points: points.map((p) => ({ lat: p.lat, lon: p.lon, label: fiche(p.libelle, c.nature) })) },
  }));
const defibrillateurs = pointsDeCouche('defibrillateurs');
---

<Base
  title="Vie quotidienne à Luynes — Luynes en chiffres"
  description={`Vie quotidienne à Luynes : ${pourcent(f.fibre_pct)} de locaux raccordables à la fibre, ${formatNumber(d.defibrillateurs)} défibrillateurs, covoiturage, points d'apport volontaire du verre et carte.`}
  sources={CREDITS_QUOTIDIEN}
>
  <section aria-labelledby="titre" class="pt-12 pb-10 sm:pt-20">
    <p class="flex items-center gap-2 font-medium text-loire"><Icon name="tasse" class="h-5 w-5" /> Thème · Vie quotidienne</p>
    <h1 id="titre" class="mt-3 font-display text-[2.6rem] leading-[0.95] font-extrabold tracking-tight min-[380px]:text-5xl sm:text-8xl">
      Au <span class="text-accent">quotidien</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      Internet, premiers secours, covoiturage, tri du verre, bancs : ce qui rend les journées plus simples à Luynes, d'après les
      données publiées par l'ARCEP, le ministère de la Santé, le registre de preuve de covoiturage et Tours Métropole.
    </p>
  </section>

  <section aria-label="Chiffres clés de la vie quotidienne" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <KeyFigure tone="loire" icon="wifi" label={`Des locaux raccordables à la fibre (${dernierTrimestreFibre})`} value={f.fibre_pct} decimals={1} unit="%" info={methode('quotidien_fibre')}>
      <p class="mt-3 text-sm opacity-90">{formatNumber(f.fibre)} locaux sur {formatNumber(f.locaux)} ; Indre-et-Loire : {pourcent(f.fibre_pct_37)}.</p>
    </KeyFigure>
    <KeyFigure icon="sante" label="Défibrillateurs pour 1 000 habitants" value={d.pour_1000} decimals={1} info={methode('quotidien_dae')}>
      <p class="mt-3 text-sm text-ink-2">{formatNumber(d.defibrillateurs)} appareils ; Indre-et-Loire : {formatOneDecimal(d.pour_1000_37)}.</p>
    </KeyFigure>
    <KeyFigure tone="accent" icon="voiture" label={`Trajets de covoiturage partis de Luynes (${cov.annee})`} value={cov.trajets} info={methode('quotidien_covoiturage')}>
      <p class="mt-3 text-sm text-ink-2">{formatOneDecimal(cov.pour_1000)} pour 1 000 habitants ; Indre-et-Loire : {formatOneDecimal(cov.pour_1000_37)}.</p>
    </KeyFigure>
    <KeyFigure icon="vitre" label="Points d'apport volontaire du verre" value={m.verre} info={methode('quotidien_verre')}>
      <p class="mt-3 text-sm text-ink-2">Un pour {formatNumber(m.verre_habitants_par_point)} habitants ; Tours Métropole : un pour {formatNumber(m.verre_habitants_par_point_metropole)}.</p>
    </KeyFigure>
  </section>

  <section id="internet" aria-labelledby="internet-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="internet-titre" class={titreH2}>La fibre arrive</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      L'ARCEP recense chaque trimestre les locaux (logements, commerces, bureaux…) qui peuvent être raccordés à la fibre optique jusqu'au domicile.
      « Raccordable » ne veut pas dire « raccordé » : l'abonnement reste un choix de chaque occupant.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <div class="grid gap-6">
        <Waffle
          info={methode('quotidien_fibre')}
          title={`Sur 100 locaux de Luynes (${dernierTrimestreFibre})`}
          unit="locaux"
          colors={['var(--chart-1)', 'var(--bar)']}
          items={[
            { label: 'Raccordables à la fibre', value: f.fibre_pct },
            { label: 'Pas encore raccordables', value: 100 - f.fibre_pct },
          ]}
          ariaLabel={`${pourcent(f.fibre_pct)} des locaux de Luynes, soit ${formatNumber(f.fibre)} sur ${formatNumber(f.locaux)}, peuvent être raccordés à la fibre.`}
        />
        <RankGauge
          info={methode('quotidien_fibre')}
          label="Part de locaux raccordables à la fibre"
          rank={f.rang}
          total={f.nb_communes}
          icon="wifi"
          ends={['la plus forte part', 'la plus faible']}
        />
      </div>
      <div class={carte}>
        <p class="flex items-center gap-2 text-sm font-semibold">Part de locaux raccordables, publication après publication <InfoTip methode={methode('quotidien_fibre_evolution')} label="Évolution de la fibre" /></p>
        <p class="mt-1 text-sm text-ink-2">
          <span class="mr-1 inline-block size-2.5 rounded-full bg-loire align-middle" aria-hidden="true"></span> Luynes
          <span class="mx-2 text-line">·</span>
          <span class="mr-1 inline-block size-2.5 rounded-full bg-line align-middle ring-1 ring-ink-2" aria-hidden="true"></span> Indre-et-Loire
        </p>
        <ul class="mt-6 space-y-4" aria-label="Part de locaux raccordables à la fibre par trimestre">
          {
            trimestresFibre.map((t) => (
              <li>
                <p class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm">
                  <span class="font-semibold">{libelleTrimestre(t)}</span>
                  <span class="tabular-nums"><strong>{pourcent(t.luynes_pct)}</strong> <span class="text-ink-2">(département : {pourcent(t.departement_pct)})</span></span>
                </p>
                <span class="mt-1 block h-2.5 rounded-full bg-line" aria-hidden="true">
                  <span class="block h-full rounded-full bg-loire" style={`width: ${largeur(t.luynes_pct, 100)}`}></span>
                </span>
                <span class="mt-1 block h-1.5 rounded-full bg-line/50" aria-hidden="true">
                  <span class="block h-full rounded-full bg-ink-2/40" style={`width: ${largeur(t.departement_pct, 100)}`}></span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 border-t border-line pt-4 text-sm text-ink-2">
          De {pourcent(f.fibre_pct_debut)} à {pourcent(f.fibre_pct)} à Luynes ({gainPoints > 0 ? '+' : ''}{formatOneDecimal(gainPoints)} points) et de {pourcent(f.fibre_pct_37_debut)} à
          {pourcent(f.fibre_pct_37)} en Indre-et-Loire. Au dernier trimestre, {formatNumber(f.sans_fibre)} locaux de Luynes ne sont pas encore raccordables ;
          {formatNumber(f.communes_100_pct)} communes du département le sont toutes. La couverture mobile (4G, 5G) n'est pas présentée : l'ARCEP la publie en cartes nationales, sans chiffre par commune.
        </p>
      </div>
    </div>
  </section>

  <section id="secours" aria-labelledby="secours-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="secours-titre" class={titreH2}>En cas d'urgence</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      La base nationale Géo'DAE rassemble les défibrillateurs déclarés par leurs exploitants. Elle dépend de ces déclarations : un appareil non déclaré n'y figure pas.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class={carte}>
        <p class="flex items-center gap-2 text-sm font-semibold">Pour 1 000 habitants <InfoTip methode={methode('quotidien_dae')} label="Défibrillateurs" /></p>
        <MiniCompare items={duo(d.pour_1000, ['Indre-et-Loire', d.pour_1000_37], (v) => formatOneDecimal(v))} />
        <p class="mt-5 text-sm text-ink-2">
          {formatNumber(d.defibrillateurs)} défibrillateurs à Luynes : {formatRankOf(d.rang, d.nb_communes)}. {formatNumber(d.communes_sans)} communes du département n'en ont aucun dans la base.
        </p>
      </div>
      <div class={carte}>
        <p class="flex items-center gap-2 text-sm font-semibold">Où et quand y accéder ? <InfoTip methode={methode('quotidien_dae_acces')} label="Accès aux défibrillateurs" /></p>
        <ul class="mt-5 grid gap-3 min-[460px]:grid-cols-2">
          <li class="flex items-center gap-3 rounded-2xl border border-line p-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name="sante" class="h-5 w-5" /></span>
            <span><span class="block font-display text-2xl font-bold">{formatNumber(d.exterieurs)}</span><span class="block text-xs text-ink-2">posés à l'extérieur d'un bâtiment</span></span>
          </li>
          <li class="flex items-center gap-3 rounded-2xl border border-line p-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-accent-soft text-accent"><Icon name="sablier" class="h-5 w-5" /></span>
            <span><span class="block font-display text-2xl font-bold">{formatNumber(d.permanents)}</span><span class="block text-xs text-ink-2">avec un accès déclaré 24 h/24</span></span>
          </li>
        </ul>
        <p class="mt-4 text-sm text-ink-2">
          {formatNumber(d.exterieurs_permanents)} appareils sont à la fois à l'extérieur et accessibles 24 h/24. Les autres n'ont pas d'accès permanent déclaré dans la base (cela ne veut pas dire qu'ils sont inaccessibles).
        </p>
      </div>
    </div>
  </section>

  <section id="covoiturage" aria-labelledby="covoiturage-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="covoiturage-titre" class={titreH2}>On covoiture</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Trajets réalisés en covoiturage par l'intermédiaire d'une plateforme et enregistrés au registre de preuve de covoiturage, avec Luynes comme commune de départ.
      Le covoiturage entre connaissances n'y figure pas ; les volumes varient beaucoup d'une année à l'autre.
    </p>
    <div class:list={['mt-8', carte]}>
      <p class="flex items-center gap-2 text-sm font-semibold">Trajets pour 1 000 habitants <InfoTip methode={methode('quotidien_covoiturage')} label="Covoiturage" /></p>
      <p class="mt-1 text-sm text-ink-2">
        <span class="mr-1 inline-block size-2.5 rounded-full bg-accent align-middle" aria-hidden="true"></span> Luynes
        <span class="mx-2 text-line">·</span>
        <span class="mr-1 inline-block size-2.5 rounded-full bg-line align-middle ring-1 ring-ink-2" aria-hidden="true"></span> Indre-et-Loire
      </p>
      <ul class="mt-6 space-y-4" aria-label="Trajets de covoiturage pour 1 000 habitants, par année">
        {
          anneesCovoiturage.map((a) => (
            <li>
              <p class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm">
                <span class="font-semibold">{a.annee}</span>
                <span class="tabular-nums"><strong>{formatNumber(a.trajets)} trajets</strong> <span class="text-ink-2">({formatOneDecimal(a.pour_1000)} pour 1 000 ; département : {formatOneDecimal(a.pour_1000_37)})</span></span>
              </p>
              <span class="mt-1 block h-2.5 rounded-full bg-line" aria-hidden="true">
                <span class="block h-full rounded-full bg-accent" style={`width: ${largeur(a.pour_1000, maxCovoiturage)}`}></span>
              </span>
              <span class="mt-1 block h-1.5 rounded-full bg-line/50" aria-hidden="true">
                <span class="block h-full rounded-full bg-ink-2/40" style={`width: ${largeur(a.pour_1000_37, maxCovoiturage)}`}></span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="mobilier" aria-labelledby="mobilier-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="mobilier-titre" class={titreH2}>Trier, s'asseoir</h2>
    <p class="mt-4 max-w-2xl text-ink-2">
      Les inventaires de Tours Métropole recensent les points d'apport volontaire (verre, textile) et les bancs publics de ses communes, dont Luynes.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class={carte}>
        <p class="flex items-center gap-2 text-sm font-semibold">Verre : habitants par point d'apport <InfoTip methode={methode('quotidien_verre')} label="Points d'apport volontaire du verre" /></p>
        <MiniCompare items={duo(m.verre_habitants_par_point, ['Tours Métropole', m.verre_habitants_par_point_metropole], (v) => formatNumber(v))} />
        <p class="mt-5 text-sm text-ink-2">
          {formatNumber(m.verre)} points à Luynes, soit un pour {formatNumber(m.verre_habitants_par_point)} habitants : {formatRankOf(m.verre_rang, m.verre_nb_communes, ENSEMBLE_VERRE)} (rang 1 = le moins d'habitants par point).
        </p>
      </div>
      <div class={carte}>
        <p class="flex items-center gap-2 text-sm font-semibold">Dans l'espace public <InfoTip methode={methode('quotidien_mobilier')} label="Bancs et autres équipements" /></p>
        <ul class="mt-5 grid gap-3 min-[460px]:grid-cols-2">
          <li class="flex items-center gap-3 rounded-2xl border border-line p-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-loire-soft text-loire"><Icon name="pion" class="h-5 w-5" /></span>
            <span><span class="block font-display text-2xl font-bold">{formatNumber(m.bancs)}</span><span class="block text-xs text-ink-2">bancs publics recensés</span></span>
          </li>
          <li class="flex items-center gap-3 rounded-2xl border border-line p-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-accent-soft text-accent"><Icon name="sac" class="h-5 w-5" /></span>
            <span><span class="block font-display text-2xl font-bold">{formatNumber(m.textile)}</span><span class="block text-xs text-ink-2">point{m.textile > 1 ? 's' : ''} d'apport du textile</span></span>
          </li>
        </ul>
        <p class="mt-4 text-sm text-ink-2">
          Pas de comparaison pour les bancs : l'inventaire de la métropole est très inégal d'une commune à l'autre, il ne dit pas combien de bancs existent réellement.
        </p>
      </div>
    </div>
  </section>

  <section id="carte" aria-labelledby="carte-titre" class="reveal mt-20 scroll-mt-24 sm:mt-28">
    <h2 id="carte-titre" class={titreH2}>La carte</h2>
    <p class="mt-4 max-w-2xl text-ink-2">Défibrillateurs, points d'apport volontaire et bancs recensés à Luynes. Cliquer sur un point pour son détail.</p>
    <div class="mt-8">
      <MapView
        info={methode('quotidien_carte')}
        ariaLabel={`Carte de Luynes : ${formatNumber(d.defibrillateurs)} défibrillateurs, points d'apport volontaire et bancs publics`}
        contour={contourCommune}
        legend={legende}
      >
        <details>
          <summary class="cursor-pointer text-sm font-semibold hover:text-loire">La liste des {formatNumber(defibrillateurs.length)} défibrillateurs</summary>
          <ul class="mt-3 grid gap-x-8 text-sm sm:grid-cols-2">
            {defibrillateurs.map((p) => <li class="border-b border-line/60 py-1.5">{p.libelle}</li>)}
          </ul>
        </details>
      </MapView>
    </div>
  </section>

  <FunFacts facts={faitsQuotidien()} id="saviez-vous-quotidien" />
  <SourcesMethode page="quotidien" />
</Base>
